{
  "name": "brasa",
  "description": "Brasa — a premium, dark-first, ember-accented multi-purpose theme for Astro.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro",
    "astro-theme",
    "astro-template",
    "tailwind",
    "saas",
    "docs",
    "blog"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-expressive-code": "^0.44.4",
    "expressive-code": "^0.44.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "wawoff2": "^2.0.1"
  }
}
