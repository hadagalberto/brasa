---
/**
 * Feature comparison. One source of truth renders a real semantic table on
 * desktop and a per-plan card list on phones — no sideways scrolling, no
 * duplicated content visible to assistive technology.
 */
import Icon from './Icon.astro';
import { ui, type Locale } from '../i18n';

interface Row {
  label: string;
  /** One value per tier, in tier order. */
  values: Array<string | boolean>;
}

interface Props {
  tiers: Array<{ name: string; featured?: boolean }>;
  groups: string[];
  rows: Row[];
  lang: Locale;
  class?: string;
}

const { tiers, groups, rows, lang, class: className } = Astro.props;
const strings = ui(lang).pricing.compare;

/** Split rows across the declared groups, evenly by count. */
const perGroup = Math.ceil(rows.length / groups.length);
const sections = groups.map((name, index) => ({
  name,
  rows: rows.slice(index * perGroup, (index + 1) * perGroup),
}));
---

<div class:list={['comparison', className]}>
  <!-- Desktop: sticky-header semantic table -->
  <div class="hidden overflow-hidden rounded-2xl border border-line bg-surface md:block">
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label={strings.title}>
      <table class="w-full min-w-[52rem] border-collapse text-start">
        <caption class="sr-only">{strings.title}</caption>
        <thead>
          <tr>
            <th
              scope="col"
              class="sticky top-16 z-2 min-w-[15rem] border-b border-line bg-surface-2 px-5 py-4 text-start font-mono text-[0.6875rem] tracking-[0.12em] text-ink-3 uppercase"
            >
              {strings.tier}
            </th>
            {tiers.map((tier) => (
              <th
                scope="col"
                class:list={[
                  'sticky top-16 z-2 min-w-[10rem] border-b border-line bg-surface-2 px-5 py-4 text-center font-mono text-[0.6875rem] tracking-[0.12em] uppercase',
                  tier.featured ? 'text-accent' : 'text-ink-2',
                ]}
              >
                {tier.name}
              </th>
            ))}
          </tr>
        </thead>
        {sections.map((section) => (
          <tbody>
            <tr>
              <th
                colspan={tiers.length + 1}
                scope="colgroup"
                class="border-b border-line bg-canvas-deep px-5 py-3 text-start font-mono text-[0.6875rem] font-medium tracking-[0.14em] text-ink-2 uppercase"
              >
                {section.name}
              </th>
            </tr>
            {section.rows.map((row) => (
              <tr class="border-b border-line/60 last:border-b-0">
                <th scope="row" class="px-5 py-4 text-start text-sm font-medium text-ink-2">
                  {row.label}
                </th>
                {row.values.map((value) => (
                  <td class="relative px-5 py-4 text-center text-sm text-ink">
                    {typeof value === 'boolean' ? (
                      value ? (
                        <span class="inline-flex items-center gap-1.5 text-accent">
                          <Icon name="check" size={15} strokeWidth={2.4} />
                          <span class="sr-only">{strings.included}</span>
                        </span>
                      ) : (
                        <span class="text-ink-3" aria-label={strings.notIncluded}>
                          —
                        </span>
                      )
                    ) : (
                      value
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>

  <!-- Mobile: one card per tier -->
  <div class="grid gap-4 md:hidden">
    {tiers.map((tier, tierIndex) => (
      <section
        aria-label={tier.name}
        class:list={[
          'rounded-2xl border bg-surface p-5',
          tier.featured ? 'border-accent/40' : 'border-line',
        ]}
      >
        <h3 class="font-display text-display-sm text-ink">{tier.name}</h3>
        {sections.map((section) => (
          <div class="mt-6">
            <h4 class="font-mono text-[0.625rem] tracking-[0.14em] text-accent uppercase">
              {section.name}
            </h4>
            <dl class="mt-3 divide-y divide-line">
              {section.rows.map((row) => (
                <div class="flex items-start justify-between gap-4 py-2.5 text-sm">
                  <dt class="max-w-[60%] text-ink-2">{row.label}</dt>
                  <dd class="relative text-right font-medium text-ink">
                    {typeof row.values[tierIndex] === 'boolean' ? (
                      row.values[tierIndex] ? (
                        <span class="inline-flex items-center gap-1 text-accent">
                          <Icon name="check" size={15} strokeWidth={2.4} />
                          <span class="sr-only">{strings.included}</span>
                        </span>
                      ) : (
                        <span class="text-ink-3" aria-label={strings.notIncluded}>
                          —
                        </span>
                      )
                    ) : (
                      row.values[tierIndex]
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </section>
    ))}
  </div>
</div>
