---
/**
 * "How it works" — numbered steps joined by a connector that draws itself as
 * the section scrolls into view (scroll-driven animation with an @supports
 * guard; browsers without it — and reduced-motion users — get the full line,
 * instantly). The connector runs between step nodes: vertical on mobile,
 * horizontal from md up.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

export interface Step {
  icon: IconName;
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
  class?: string;
}

const { steps, class: className } = Astro.props;

/**
 * A 4-step list in a 3-column grid leaves a lonely final step and a connector
 * pointing into empty space. Pick columns from the step count instead: 3 for
 * the classic trio, 2 for even lists (4 steps → a tidy 2×2).
 */
const columns = steps.length <= 3 ? Math.max(1, steps.length) : steps.length % 3 === 0 ? 3 : 2;
---

<ol class:list={['steps grid grid-cols-1 gap-12 md:gap-8', className]} data-cols={columns}>
  {steps.map((step, index) => (
    <li class="step">
      <div class="flex size-12 items-center justify-center rounded-full border border-line-strong bg-surface-2 shadow-sm">
        <Icon name={step.icon} size={20} class="text-accent" />
      </div>
      <!-- On phones the connector runs down the left gutter; indenting the
           copy keeps it from crossing the words. -->
      <div class="mt-6 pl-14 md:pl-0">
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
          Step {String(index + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-2.5 font-display text-display-sm text-ink text-balance">{step.title}</h3>
        <p class="mt-3 max-w-[38ch] text-sm leading-relaxed text-ink-2 text-pretty">{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .step {
    position: relative;
  }

  /* Column count follows the content, so no step is ever alone in a row. */
  @media (min-width: 768px) {
    .steps[data-cols='1'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps[data-cols='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps[data-cols='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* No connector leaving the last step of a row. */
    .steps[data-cols='2'] .step:nth-child(2n)::before,
    .steps[data-cols='2'] .step:nth-child(2n)::after,
    .steps[data-cols='3'] .step:nth-child(3n)::before,
    .steps[data-cols='3'] .step:nth-child(3n)::after {
      display: none;
    }
  }

  /* Static connector segments: node edge → next node edge. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: calc(-3rem + 24px);
    width: 2px;
    background: var(--line);
  }

  @media (min-width: 768px) {
    .step:not(:last-child)::before {
      left: 48px;
      right: calc(-2rem - 24px);
      top: 23px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }

  /* Ember overlay drawn along the same path, scroll-linked when supported. */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: calc(-3rem + 24px);
    width: 2px;
    background-image: var(--gradient-ember);
    transform: scaleY(1);
    transform-origin: top center;
  }

  @media (min-width: 768px) {
    .step:not(:last-child)::after {
      left: 48px;
      right: calc(-2rem - 24px);
      top: 23px;
      bottom: auto;
      width: auto;
      height: 2px;
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step:not(:last-child)::after {
        animation: step-draw-v 400ms linear both;
        animation-timeline: view();
        animation-range: entry 15% cover 40%;
      }
    }
  }

  @media (min-width: 768px) {
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .step:not(:last-child)::after {
          animation-name: step-draw-h;
        }
      }
    }
  }

  @keyframes step-draw-v {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  @keyframes step-draw-h {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }
</style>
