---
/**
 * Cards — a responsive grid of linked summary cards. Used on the docs landing
 * page and available to MDX authors as a live example of the card system.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

export interface CardItem {
  title: string;
  description: string;
  href: string;
  icon?: IconName;
  /** Small mono label above the title, e.g. a reading time. */
  meta?: string;
}

interface Props {
  items: CardItem[];
  columns?: 2 | 3;
  class?: string;
}

const { items, columns = 2, class: className } = Astro.props;
---

<ul
  class:list={[
    'cards not-prose grid grid-cols-1 gap-4 sm:grid-cols-2',
    columns === 3 && 'lg:grid-cols-3',
    className,
  ]}
>
  {items.map((item) => (
    <li>
      <a href={item.href} class="card group flex h-full flex-col gap-3.5">
        <span class="flex items-start justify-between gap-3">
          <span class="card-icon inline-flex size-10 items-center justify-center rounded-xl border border-line bg-surface-2 text-accent">
            <Icon name={item.icon ?? 'book'} size={18} />
          </span>
          <Icon
            name="arrow-up-right"
            size={16}
            class="mt-1 text-ink-3 transition-all duration-(--dur-2) ease-(--ease-out-soft) group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
          />
        </span>
        <span class="flex-1">
          {item.meta && (
            <span class="mb-2 block font-mono text-[0.6875rem] font-medium tracking-[0.14em] text-ink-3 uppercase">
              {item.meta}
            </span>
          )}
          <span class="block font-display text-[1.375rem] leading-tight font-medium tracking-[-0.015em] text-ink text-balance">
            {item.title}
          </span>
          <span class="mt-2 block text-sm leading-relaxed text-ink-2 text-pretty">
            {item.description}
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .card {
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    padding: 1.375rem;
    box-shadow: var(--elev-sm);
    transition:
      border-color var(--dur-2) var(--ease-out-soft),
      background-color var(--dur-2) var(--ease-out-soft),
      transform var(--dur-2) var(--ease-out-soft),
      box-shadow var(--dur-2) var(--ease-out-soft);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    background-color: var(--surface-2);
    box-shadow: var(--elev-md);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card-icon {
    transition:
      color var(--dur-2) var(--ease-out-soft),
      border-color var(--dur-2) var(--ease-out-soft);
  }

  .card:hover .card-icon {
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
  }
</style>
