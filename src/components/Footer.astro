---
import { brasa, featureEnabled, localizedColumnTitle, localizedLabel } from '../brasa.config';
import { withBase } from '../lib/with-base';
import { localizedPath, ui, type Locale } from '../i18n';
import Container from './Container.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Newsletter from './Newsletter.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const strings = ui(lang).footer;
const year = new Date().getFullYear();

function linkHref(href: string): string {
  if (href.startsWith('http') || href.startsWith('#')) return href;
  // Feeds are global endpoints, not localized pages.
  if (/\.(xml|json)$/.test(href)) return withBase(href);
  return localizedPath(href, lang);
}
---

<footer class="border-t border-line bg-canvas-deep" data-pagefind-ignore>
  <Container size="lg" class="pt-16 pb-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1.25fr_repeat(3,1fr)] md:gap-8">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-5 text-sm leading-relaxed text-ink-2 text-pretty">{strings.description}</p>
        <div class="mt-6 flex items-center gap-1">
          {brasa.footer.socials
            .filter((social) => featureEnabled(social.href))
            .map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="inline-flex size-9 items-center justify-center rounded-full border border-transparent text-ink-2 transition-colors duration-(--dur-1) hover:border-line hover:bg-surface hover:text-ink"
              >
                <Icon name={social.icon} size={17} />
              </a>
            ))}
        </div>
        <Newsletter {lang} />
      </div>

      {brasa.footer.columns
        .map((column) => ({
          ...column,
          links: column.links.filter((link) => featureEnabled(link.href)),
        }))
        .filter((column) => column.links.length > 0)
        .map((column) => (
          <nav aria-label={localizedColumnTitle(column, lang)}>
            <h2 class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
              {localizedColumnTitle(column, lang)}
            </h2>
            <ul class="mt-4 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={linkHref(link.href)}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="inline-flex items-center gap-1.5 text-sm text-ink-2 transition-colors duration-(--dur-1) hover:text-ink"
                  >
                    {localizedLabel(link, lang)}
                    {link.external && <Icon name="arrow-up-right" size={12} class="opacity-50" />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-line pt-8 sm:flex-row sm:items-center">
      <p class="text-xs text-ink-3">{strings.copyright(year, brasa.site.author)}</p>
      <p class="inline-flex items-center gap-1.5 text-xs text-ink-3">
        <Icon name="flame" size={13} class="text-ember-500" />
        {brasa.footer.note}
      </p>
    </div>
  </Container>
</footer>
