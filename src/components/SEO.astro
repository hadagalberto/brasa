---
import { brasa } from '../brasa.config';

interface Props {
  title: string;
  description?: string;
  /** Path or URL for the Open Graph image. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = brasa.site.description,
  image = `${import.meta.env.BASE_URL}og.png`,
  type = 'website',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const fullTitle =
  title === brasa.site.name
    ? `${brasa.site.name} — ${brasa.site.tagline}`
    : `${title} · ${brasa.site.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brasa.site.name,
  description: brasa.site.description,
  url: site.toString(),
  author: {
    '@type': 'Person',
    name: brasa.site.author,
    url: brasa.site.github,
  },
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#120c09" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={brasa.site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${brasa.site.name} — ${brasa.site.tagline}`} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
