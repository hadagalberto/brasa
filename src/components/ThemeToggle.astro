---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-transparent text-ink-2 transition-colors duration-(--dur-1) hover:border-line hover:bg-surface hover:text-ink"
>
  <Icon name="sun" size={17} class="theme-icon-sun" />
  <Icon name="moon" size={17} class="theme-icon-moon" />
</button>
