---
import { brasa } from '../brasa.config';
import { localizedPath, normalizeLocale, ui } from '../i18n';

interface Props {
  /** Hide the wordmark (used where the name is already visible). */
  markOnly?: boolean;
  href?: string;
}

// Frontmatter runs per instance, so a local counter reset for every Logo and
// every page got duplicate id="ember-mark-1". A UUID is unique per instance.
const gradientId = `ember-mark-${crypto.randomUUID().replaceAll('-', '')}`;
const lang = normalizeLocale(Astro.currentLocale);
const { markOnly = false, href = localizedPath('/', lang) } = Astro.props;
const homeLabel = ui(lang).common.homeLabel(brasa.site.name);
---

<a href={href} class="group inline-flex items-center gap-2.5 rounded-lg" aria-label={homeLabel}>
  <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <linearGradient id={gradientId} x1="0.15" y1="1" x2="0.9" y2="0.1">
        <stop offset="0" style="stop-color: var(--color-ember-600)"></stop>
        <stop offset="1" style="stop-color: var(--color-ember-300)"></stop>
      </linearGradient>
    </defs>
    <path
      d="M12.6 1.9c.6 2.9-.2 5.3-2 7.2-1.7 1.9-3.6 3.6-3.6 6.4 0 3.9 3 6.5 7 6.5s7-2.6 7-6.5c0-2.6-1.2-4.7-2.8-6.3-1.1-1.2-2.3-2.2-2.9-3.6-.9 1-1.3 2.3-1.1 3.7-1.4-1.6-2.4-3.1-2.8-5l-.8-2.4Z"
      fill={`url(#${gradientId})`}
    ></path>
    <circle cx="14.1" cy="14.6" r="2" style="fill: var(--canvas)"></circle>
    <circle cx="14.1" cy="14.6" r="1" style="fill: var(--color-ember-500)"></circle>
  </svg>
  {!markOnly && (
    <span class="font-display text-[1.35rem] leading-none font-semibold tracking-tight text-ink">
      {brasa.logo.text}
      <span class="text-accent">.</span>
    </span>
  )}
</a>
