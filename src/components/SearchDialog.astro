---
/**
 * Custom-styled Pagefind dialog. Opened by the header button, Ctrl/⌘+K or '/'.
 * The panel is a native <dialog> so showModal() gives a real focus trap and an
 * inert background; search.ts adds result navigation and live status.
 */
import Icon from './Icon.astro';
import { withBase } from '../lib/with-base';
import { localizedPath, ui, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const strings = ui(lang).common;
const clientStrings = {
  intro: strings.searchIntro,
  introTitle: strings.searchIntroTitle,
  introHint: strings.searchIntroHint,
  noResults: strings.searchNoResults('«q»'),
  noResultsHint: strings.searchNoResultsHint,
  browseDocs: strings.searchBrowseDocs,
  searching: strings.searchSearching('«q»'),
  noMatches: strings.searchNoMatches('«q»'),
  matchOne: strings.searchMatches(1, '«q»'),
  matchMany: strings.searchMatches(2, '«q»'),
  unavailable: strings.searchUnavailable,
  unavailableTitle: strings.searchUnavailableTitle,
  unavailableHint: strings.searchUnavailableHint,
  navigate: strings.searchNavigate,
  open: strings.searchOpen,
  close: strings.searchClose,
  powered: strings.searchPowered,
  docsHref: localizedPath('/docs', lang),
  lang,
};
---

<dialog
  id="search-dialog"
  data-search-dialog
  data-search-base={withBase('/')}
  data-search-strings={JSON.stringify(clientStrings)}
  aria-label={strings.searchDialog}
  class="search-dialog"
  data-pagefind-ignore
>
  <div class="search-panel">
    <div class="search-bar">
      <Icon name="search" size={19} class="shrink-0 text-accent" />
      <input
        data-search-input
        type="search"
        aria-label={strings.searchDialog}
        placeholder={strings.searchPlaceholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button type="button" data-search-close aria-label={strings.closeSearch} class="search-close">
        <Icon name="close" size={15} />
      </button>
    </div>

    <p data-search-status class="search-status" role="status" aria-live="polite">
      {strings.searchIntro}
    </p>

    <div data-search-results class="search-results"></div>

    <div class="search-footer" aria-hidden="true">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> {strings.searchNavigate}
      </span>
      <span>
        <kbd>↵</kbd> {strings.searchOpen}
      </span>
      <span>
        <kbd>esc</kbd> {strings.searchClose}
      </span>
      <span class="search-powered">{strings.searchPowered}</span>
    </div>
  </div>
</dialog>

<style>
  /* eslint-disable astro/no-unused-css-selector -- open is applied by showModal() */
  .search-dialog {
    position: fixed;
    inset: 0;
    width: min(42rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 4rem);
    height: fit-content;
    margin: clamp(2rem, 10vh, 7rem) auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xl);
    background-color: var(--canvas-deep);
    color: var(--ink);
    box-shadow:
      var(--elev-lg),
      0 0 0 1px color-mix(in oklab, var(--accent) 12%, transparent);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: oklch(0.07 0.016 40 / 0.72);
    backdrop-filter: blur(5px) saturate(0.85);
  }

  :global(.search-dialog[open]) {
    animation: search-in var(--dur-2) var(--ease-out-soft) both;
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    border-block-end: 1px solid var(--line);
    padding: 1rem 1.125rem;
    background-color: color-mix(in oklab, var(--surface) 70%, transparent);
  }

  .search-bar input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
  }

  .search-bar input::placeholder {
    color: var(--ink-3);
  }

  .search-bar input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-3);
    cursor: pointer;
    transition:
      color var(--dur-1) var(--ease-out-soft),
      border-color var(--dur-1) var(--ease-out-soft);
  }

  .search-close:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .search-status {
    padding: 0.875rem 1.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .search-results {
    min-height: 7rem;
    overflow-y: auto;
    padding: 0.625rem;
  }

  .search-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    border-block-start: 1px solid var(--line);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    background-color: color-mix(in oklab, var(--surface) 60%, transparent);
  }

  .search-footer span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .search-footer .search-powered {
    margin-inline-start: auto;
  }

  @media (max-width: 640px) {
    .search-footer .search-powered {
      display: none;
    }
  }

  kbd {
    display: inline-flex;
    min-width: 1.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-block-end-width: 2px;
    border-radius: var(--radius-xs);
    padding: 0.1rem 0.3rem;
    font-family: inherit;
    font-size: 0.625rem;
    color: var(--ink-2);
  }

  /* Result markup is built by search.ts at runtime. */
  :global(.search-result-group) {
    display: block;
    border-radius: var(--radius-md);
    transition: background-color var(--dur-1) var(--ease-out-soft);
  }

  :global(.search-result-group:focus-within) {
    background-color: color-mix(in oklab, var(--accent) 8%, transparent);
  }

  :global(.search-result-sections) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0 0.875rem 0.75rem 2.75rem;
  }

  :global(.search-result-section) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    text-decoration: none;
    transition:
      color var(--dur-1) var(--ease-out-soft),
      border-color var(--dur-1) var(--ease-out-soft);
  }

  :global(.search-result-section:hover),
  :global(.search-result-section:focus-visible) {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(.search-result) {
    display: block;
    border-radius: var(--radius-md);
    padding: 0.75rem 0.875rem;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out-soft);
  }

  :global(.search-result:hover),
  :global(.search-result:focus-visible),
  :global(.search-result[data-cursor]) {
    background-color: var(--accent-soft);
    outline: none;
  }

  :global(.search-result-top) {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    min-width: 0;
  }

  :global(.search-result-title) {
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 560;
    color: var(--ink);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  :global(.search-result-path) {
    margin-inline-start: auto;
    flex: 0 1 auto;
    max-width: 45%;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    :global(.search-result-path) {
      display: none;
    }
  }

  :global(.search-result-excerpt) {
    margin-block-start: 0.3rem;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  :global(.search-result-excerpt mark) {
    border-radius: 3px;
    background-color: color-mix(in oklab, var(--ember-400) 34%, transparent);
    color: var(--ink);
    padding-inline: 0.15em;
  }

  :global(.search-empty) {
    padding: 2rem 1rem 2.5rem;
    text-align: center;
  }

  :global(.search-empty p) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  :global(.search-empty span) {
    display: block;
    margin-block-start: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  :global(.search-suggestions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-block-start: 1.25rem;
  }

  :global(.search-chip) {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  :global(.search-chip:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.search-dialog[open]) {
      animation: none;
    }
  }
</style>
