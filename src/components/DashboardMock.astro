---
/**
 * Hero product mock — a Brasa Cloud deploy dashboard, pure HTML/CSS.
 * Nothing here is an image: the window, pipeline, log stream, pulse and
 * blinking cursor are all DOM + CSS, so it re-themes with the accent hue and
 * stays crisp at every density. Decorative by design (aria-hidden): it
 * illustrates the copy next to it rather than carrying information itself.
 */
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stages = [
  { label: 'install', time: '0.8s', done: true },
  { label: 'build', time: '3.1s', done: true },
  { label: 'smoke', time: '1.2s', done: true },
  { label: 'publish', time: '1.1s', done: false },
] as const;

const logs = [
  { time: '12:04:18', level: 'ok', body: 'deps restored from cache · 214 packages' },
  { time: '12:04:19', level: 'info', body: 'building 214 routes on 4 runners' },
  { time: '12:04:21', level: 'ok', body: 'route data prefetched · gru, iad, fra' },
  { time: '12:04:22', level: 'info', body: 'smoke tests passing — 18/18' },
  { time: '12:04:24', level: 'live', body: 'published · preview-8f2k.brasa.cloud' },
] as const;
---

<div aria-hidden="true" class:list={['relative max-w-xl', className]}>
  <div class="mock-haze absolute -inset-8 -z-10 rounded-full"></div>

  <div class="mock-window relative overflow-hidden rounded-2xl border border-line bg-surface shadow-lg">
    <div class="flex items-center gap-3 border-b border-line bg-surface-2/50 px-4 py-3">
      <span class="flex shrink-0 gap-1.5">
        <span class="size-2.5 rounded-full" style="background: oklch(0.55 0.16 25)"></span>
        <span class="size-2.5 rounded-full" style="background: oklch(0.75 0.14 70)"></span>
        <span class="size-2.5 rounded-full" style="background: oklch(0.7 0.1 145)"></span>
      </span>
      <span class="flex min-w-0 flex-1 items-center gap-1.5 rounded-full border border-line bg-canvas px-3 py-1 font-mono text-[11px] text-ink-2">
        <Icon name="lock" size={11} class="shrink-0 text-ink-3" strokeWidth={2.2} />
        <span class="w-0 min-w-0 flex-1 truncate">preview-8f2k.brasa.cloud</span>
      </span>
      <span class="live-pill inline-flex shrink-0 items-center gap-1.5 rounded-full border border-accent/25 bg-accent-soft px-2.5 py-1 font-mono text-[10px] font-medium tracking-[0.1em] text-accent uppercase">
        <span class="live-dot"></span>
        live
      </span>
    </div>

    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
      <span class="flex min-w-0 items-center gap-2.5">
        <Icon name="flame" size={15} class="shrink-0 text-accent" />
        <span class="truncate text-sm font-medium text-ink">brasa/site</span>
        <span class="hidden shrink-0 rounded-full border border-line bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-ink-2 sm:inline-block">
          feat/ember-glow
        </span>
      </span>
      <span class="shrink-0 font-mono text-[10px] text-ink-3">push · 2m ago · 8f2k41</span>
    </div>

    <div class="grid grid-cols-4 divide-x divide-line border-b border-line px-4 py-3">
      {stages.map((stage) => (
        <span class="flex min-w-0 items-center justify-center gap-2 px-1.5">
          <span
            class:list={[
              'inline-flex shrink-0 items-center justify-center rounded-full',
              'size-5 border',
              stage.done
                ? 'border-transparent bg-ember-gradient text-on-accent'
                : 'live-stage border-accent/40 bg-accent-soft text-accent',
            ]}
          >
            <Icon name={stage.done ? 'check' : 'bolt'} size={11} strokeWidth={2.6} />
          </span>
          <span class="min-w-0 leading-tight">
            <span class="block truncate text-[11px] font-medium text-ink">{stage.label}</span>
            <span class="block font-mono text-[10px] text-ink-3">{stage.time}</span>
          </span>
        </span>
      ))}
    </div>

    <div class="space-y-2 px-4 py-4 font-mono text-[11px] leading-relaxed sm:text-xs">
      {logs.map((line, index) => (
        <p class="log-line flex items-baseline gap-2" style={`--i: ${index}`}>
          <span class="shrink-0 text-ink-3">{line.time}</span>
          <span
            class:list={[
              'shrink-0',
              line.level === 'ok' && 'text-accent',
              line.level === 'info' && 'text-ink-3',
              line.level === 'live' && 'text-accent',
            ]}
          >
            {line.level === 'info' ? (
              <Icon name="arrow-right" size={11} />
            ) : (
              <Icon name="check" size={11} />
            )}
          </span>
          <span
            class:list={[
              'w-0 min-w-0 flex-1 truncate',
              line.level === 'live' ? 'text-accent' : 'text-ink-2',
            ]}
          >
            {line.body}
          </span>
        </p>
      ))}
      <p class="log-line flex items-baseline gap-2" style="--i: 5">
        <span class="shrink-0 text-ink-3">12:04:25</span>
        <span class="mock-cursor shrink-0" aria-hidden="true"></span>
        <span class="text-ink-3">waiting for new pushes</span>
      </p>
    </div>

    <div class="flex items-center justify-between border-t border-line bg-surface-2/50 px-4 py-2.5 font-mono text-[10px] text-ink-3">
      <span>build 6.2s</span>
      <span class="text-accent">cache hit 97%</span>
      <span>gru · iad · fra</span>
    </div>
  </div>
</div>

<style>
  .mock-haze {
    background: radial-gradient(
      closest-side,
      oklch(0.65 0.21 var(--accent-hue) / 0.16),
      oklch(0.82 0.16 calc(var(--accent-hue) + 40) / 0.06),
      transparent
    );
  }

  /* Live status: slow ember pulse on the badge dot and the in-flight stage. */
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }

  .live-pill,
  .live-stage {
    animation: mock-pulse 2.4s var(--ease-in-out-soft) infinite;
  }

  @keyframes mock-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 35%, transparent);
    }

    50% {
      box-shadow: 0 0 0 5px transparent;
    }
  }

  /* Log lines stream in once on load, then the cursor keeps blinking. */
  .mock-cursor {
    width: 0.55ch;
    height: 1.05em;
    translate: 0 0.18em;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mock-window {
      animation: mock-enter 600ms var(--ease-out-soft) both;
    }

    .log-line {
      animation: mock-line-in 400ms var(--ease-out-soft) both;
      animation-delay: calc(var(--i) * 240ms + 350ms);
    }

    .mock-cursor {
      animation: mock-blink 1.15s steps(1) infinite;
    }
  }

  @keyframes mock-enter {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }

  @keyframes mock-line-in {
    from {
      opacity: 0;
      transform: translate3d(0, 5px, 0);
    }
  }

  @keyframes mock-blink {
    50% {
      opacity: 0;
    }
  }
</style>
