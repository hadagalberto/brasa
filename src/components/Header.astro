---
import { brasa } from '../brasa.config';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const { nav } = brasa;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isActive = (href: string): boolean => {
  if (!href.startsWith('/')) return false;
  const path = href.replace(/\/$/, '') || '/';
  return currentPath === path;
};
---

<header data-header class="sticky top-0 z-50">
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium transition-colors duration-(--dur-1)',
            isActive(item.href)
              ? 'bg-surface-2 text-ink'
              : 'text-ink-2 hover:bg-surface hover:text-ink',
          ]}
        >
          {item.label}
          {item.external && <Icon name="arrow-up-right" size={13} class="opacity-60" />}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={brasa.site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Brasa on GitHub"
        class="hidden size-9 items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink sm:inline-flex"
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="dialog"
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink md:hidden"
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    class="sheet fixed inset-0 flex flex-col"
  >
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6">
      <Logo />
      <button
        type="button"
        data-menu-toggle
        aria-label="Close menu"
        class="inline-flex size-10 cursor-pointer items-center justify-center rounded-full border border-line bg-surface-2 text-ink transition-colors duration-(--dur-1) hover:bg-surface-3"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav
      aria-label="Main (mobile)"
      class="flex flex-1 flex-col justify-center gap-3 px-6 pt-4 sm:px-10"
    >
      {nav.map((item, index) => (
        <a
          href={item.href}
          style={`--i: ${index}`}
          class:list={['sheet-link group/link', isActive(item.href) && 'is-active']}
        >
          <span class="font-mono text-sm text-accent opacity-70">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="font-display text-[clamp(2.25rem,9vw,3.5rem)] leading-none tracking-tight">
            {item.label}
          </span>
          {item.external && <Icon name="arrow-up-right" size={28} class="self-start opacity-50" />}
        </a>
      ))}
    </nav>

    <div class="flex items-center justify-between border-t border-line px-6 py-6 sm:px-10">
      <p class="font-mono text-xs tracking-wider text-ink-3 uppercase">MIT · open source</p>
      <div class="flex items-center gap-1">
        {brasa.footer.socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="inline-flex size-9 items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink"
          >
            <Icon name={social.icon} size={17} />
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  /* Translucent glass backdrop once the page scrolls past the top. */
  header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-block-end: 1px solid var(--line);
    background: color-mix(in oklab, var(--canvas) 78%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out-soft);
  }

  // The attribute is toggled by scripts/behaviors.ts once the page scrolls.
  // eslint-disable-next-line astro/no-unused-css-selector
  header[data-scrolled]::before {
    opacity: 1;
  }

  /* Full-screen sheet: slides up, links stagger in. */
  .sheet {
    z-index: 60;
    background-color: var(--canvas);
    visibility: hidden;
    transform: translateY(100%);
    transition:
      transform var(--dur-3) var(--ease-out-soft),
      visibility 0s linear var(--dur-3);
  }

  :global(html[data-menu-open]) .sheet {
    visibility: visible;
    transform: translateY(0);
    transition: transform var(--dur-3) var(--ease-out-soft);
  }

  .sheet-link {
    display: inline-flex;
    align-items: baseline;
    gap: 1.25rem;
    color: var(--ink-2);
    opacity: 0;
    translate: 0 1.25rem;
    transition:
      color var(--dur-2) var(--ease-out-soft),
      opacity var(--dur-2) var(--ease-out-soft),
      translate var(--dur-2) var(--ease-out-soft);
  }

  .sheet-link:hover,
  .sheet-link:focus-visible,
  .sheet-link.is-active {
    color: var(--ink);
  }

  .sheet-link.is-active {
    color: var(--accent);
  }

  :global(html[data-menu-open]) .sheet-link {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i) * 55ms + 140ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition:
        opacity var(--dur-1) linear,
        visibility 0s linear var(--dur-1);
      transform: none;
      opacity: 0;
    }

    :global(html[data-menu-open]) .sheet {
      transition: opacity var(--dur-1) linear;
      opacity: 1;
    }

    .sheet-link {
      translate: none;
      transition: color var(--dur-1);
    }
  }
</style>
