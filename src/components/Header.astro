---
import { brasa, featureEnabled, localizedLabel } from '../brasa.config';
import { localizedPath, ui, unlocalizedPath, type Locale } from '../i18n';
import { withBase } from '../lib/with-base';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const strings = ui(lang).common;
const nav = brasa.nav.filter((item) => featureEnabled(item.href));
const currentPath = unlocalizedPath(Astro.url.pathname).replace(/\/$/, '') || '/';

const isActive = (href: string): boolean => {
  if (!href.startsWith('/')) return false;
  const path = href.replace(/\/$/, '') || '/';
  // Root matches exactly; sections match their subtree (Blog stays active
  // on /blog/tags/…, /blog/page/2 and every article).
  return currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`));
};
---

<header data-header class="sticky top-0 z-50" data-pagefind-ignore>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav aria-label={strings.mainNav} class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <a
          href={localizedPath(item.href, lang)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium transition-colors duration-(--dur-1)',
            isActive(item.href)
              ? 'bg-surface-2 text-ink'
              : 'text-ink-2 hover:bg-surface hover:text-ink',
          ]}
        >
          {localizedLabel(item, lang)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      {brasa.features.search && (
        <button
          type="button"
          data-search-open
          aria-haspopup="dialog"
          aria-controls="search-dialog"
          aria-expanded="false"
          aria-label={strings.searchOpenLabel}
          class="hidden h-9 items-center gap-2 rounded-full border border-line bg-surface/60 pe-2 ps-3 text-sm text-ink-3 transition-colors duration-(--dur-1) hover:border-line-strong hover:text-ink sm:inline-flex lg:w-48"
        >
          <Icon name="search" size={14} />
          <span class="lg:me-auto">{strings.search}</span>
          <kbd class="hidden rounded border border-line-strong px-1.5 py-0.5 font-mono text-[0.625rem] leading-none text-ink-3 lg:inline">
            /
          </kbd>
        </button>
      )}
      <LocaleSwitcher {lang} class="hidden sm:inline-flex" />
      <a
        href={brasa.site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={strings.githubLabel('Brasa')}
        class="hidden size-9 items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink md:inline-flex"
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="dialog"
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink lg:hidden"
      >
        <span class="sr-only">{strings.openMenu}</span>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu
    role="dialog"
    aria-modal="true"
    aria-label={strings.siteMenu}
    class="sheet fixed inset-0 flex flex-col"
  >
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6">
      <Logo />
      <button
        type="button"
        data-menu-toggle
        aria-label={strings.closeMenu}
        class="inline-flex size-10 cursor-pointer items-center justify-center rounded-full border border-line bg-surface-2 text-ink transition-colors duration-(--dur-1) hover:bg-surface-3"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    {brasa.features.search && (
      <div class="px-6 sm:px-10">
        <button
          type="button"
          data-search-open
          aria-haspopup="dialog"
          aria-controls="search-dialog"
          aria-expanded="false"
          class="flex w-full items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-start text-sm text-ink-2 transition-colors duration-(--dur-1) hover:border-line-strong hover:text-ink"
        >
          <Icon name="search" size={16} class="text-accent" />
          {strings.searchMobile}
          <Icon name="arrow-right" size={15} class="ms-auto opacity-60" />
        </button>
      </div>
    )}

    <nav
      aria-label={strings.mainNavMobile}
      class="flex flex-1 flex-col justify-center gap-3 px-6 pt-4 sm:px-10"
    >
      {nav.map((item, index) => (
        <a
          href={localizedPath(item.href, lang)}
          style={`--i: ${index}`}
          class:list={['sheet-link group/link', isActive(item.href) && 'is-active']}
        >
          <span class="font-mono text-sm text-accent opacity-70">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="font-display text-[clamp(1.75rem,7vw,3rem)] leading-none tracking-tight">
            {localizedLabel(item, lang)}
          </span>
        </a>
      ))}
    </nav>

    <div class="flex items-center justify-between border-t border-line px-6 py-6 sm:px-10">
      <LocaleSwitcher {lang} />
      <div class="flex items-center gap-1">
        {brasa.footer.socials.map((social) => (
          <a
            href={withBase(social.href)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="inline-flex size-9 items-center justify-center rounded-full text-ink-2 transition-colors duration-(--dur-1) hover:bg-surface hover:text-ink"
          >
            <Icon name={social.icon} size={17} />
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  /* Translucent glass backdrop once the page scrolls past the top. */
  header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-block-end: 1px solid var(--line);
    background: color-mix(in oklab, var(--canvas) 78%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out-soft);
  }

  /* The attribute is toggled by scripts/behaviors.ts on every scroll (and on
     page load with a restored scroll position), so the glass background must
     key off it. NOTE: use CSS comments here — `//` is invalid CSS and silently
     swallows the rule when Astro compiles the <style> block. */
  /* :global() keeps this runtime-only state selector lint-clean and intentional;
     the header is a single, site-wide landmark so dropping the scope is safe. */
  :global(header[data-scrolled]::before) {
    opacity: 1;
  }

  /* Full-screen sheet: slides up, links stagger in. */
  .sheet {
    z-index: 60;
    background-color: var(--canvas);
    visibility: hidden;
    transform: translateY(100%);
    transition:
      transform var(--dur-3) var(--ease-out-soft),
      visibility 0s linear var(--dur-3);
  }

  :global(html[data-menu-open]) .sheet {
    visibility: visible;
    transform: translateY(0);
    transition: transform var(--dur-3) var(--ease-out-soft);
  }

  .sheet-link {
    display: inline-flex;
    align-items: baseline;
    gap: 1.25rem;
    color: var(--ink-2);
    opacity: 0;
    translate: 0 1.25rem;
    transition:
      color var(--dur-2) var(--ease-out-soft),
      opacity var(--dur-2) var(--ease-out-soft),
      translate var(--dur-2) var(--ease-out-soft);
  }

  .sheet-link:hover,
  .sheet-link:focus-visible,
  .sheet-link.is-active {
    color: var(--ink);
  }

  .sheet-link.is-active {
    color: var(--accent);
  }

  :global(html[data-menu-open]) .sheet-link {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i) * 55ms + 140ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition:
        opacity var(--dur-1) linear,
        visibility 0s linear var(--dur-1);
      transform: none;
      opacity: 0;
    }

    :global(html[data-menu-open]) .sheet {
      transition: opacity var(--dur-1) linear;
      opacity: 1;
    }

    .sheet-link {
      translate: none;
      transition: color var(--dur-1);
    }
  }
</style>
