---
/**
 * Footer newsletter form — static by design. Point
 * `brasa.config.ts → footer.newsletter.action` at Formspree, Buttondown or
 * your own endpoint; the empty default submits back to the current page so
 * the form is honest out of the box.
 */
import { brasa } from '../brasa.config';

const { heading, description, action, note } = brasa.footer.newsletter;
---

<form class="mt-9" action={action || undefined} method={action ? 'post' : 'get'}>
  <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">{heading}</p>
  <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">{description}</p>
  <div class="mt-4 flex items-center gap-2">
    <label for="newsletter-email" class="sr-only">
      Email address
    </label>
    <input
      id="newsletter-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@yourteam.com"
      class="h-10 w-full min-w-0 flex-1 rounded-full border border-line bg-surface-2 px-4 text-sm text-ink transition-colors duration-(--dur-1) placeholder:text-ink-3 hover:border-line-strong focus:border-accent/50 focus:outline-none"
    />
    <button
      type="submit"
      class="inline-flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line-strong bg-surface-2 px-4 text-sm font-semibold text-ink transition-all duration-(--dur-1) ease-(--ease-out-soft) hover:border-line-strong hover:bg-surface-3 hover:-translate-y-0.5 active:translate-y-0"
    >
      Subscribe
    </button>
  </div>
  <p class="mt-3 text-xs text-ink-3">{note}</p>
</form>
