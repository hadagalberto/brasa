export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Pixel size (width = height). */
  size?: number;
  class?: string;
  /** Stroke width for stroke icons. */
  strokeWidth?: number;
  /** When provided the icon is announced; otherwise aria-hidden. */
  label?: string;
}

const { name, size = 20, class: className, strokeWidth = 2, label } = Astro.props;
const icon = icons[name];
const isFill = 'fill' in icon && icon.fill === true;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? undefined : 'currentColor'}
  stroke-width={isFill ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  class={className}
>
  {icon.d.map((path: string) => (
    <path d={path} />
  ))}
</svg>
