---
/**
 * End-of-post author card — avatar, bio, link to the author page.
 */
import Avatar from '../Avatar.astro';
import Icon from '../Icon.astro';
import { authorHref } from '../../lib/posts';
import type { Author } from '../../lib/posts';

interface Props {
  author: Author;
  /** Written by the same person as the post? Then skip the "More from" copy. */
  postCount: number;
  class?: string;
}

const { author, postCount, class: className } = Astro.props;
---

<aside
  class:list={[
    'not-prose flex flex-col gap-6 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:flex-row sm:items-start sm:p-8',
    className,
  ]}
  aria-label={`About the author, ${author.data.name}`}
>
  <Avatar name={author.data.name} size={64} class="mt-1 sm:mt-0" />
  <div class="min-w-0">
    <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Written by</p>
    <h2 class="mt-2 font-display text-display-sm text-ink">
      <a
        href={authorHref(author.id)}
        class="transition-colors duration-(--dur-1) hover:text-accent"
      >
        {author.data.name}
      </a>
    </h2>
    <p class="mt-1 text-sm font-medium text-accent">{author.data.role}</p>
    <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-ink-2 text-pretty">
      {author.data.bio}
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href={authorHref(author.id)}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-2 transition-colors duration-(--dur-1) hover:text-ink"
      >
        {postCount === 1 ? 'Read their essay' : `Read all ${postCount} essays`}
        <Icon name="arrow-right" size={14} />
      </a>
      {author.data.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${author.data.name} on ${link.label}`}
          class="inline-flex size-8 items-center justify-center rounded-full border border-line text-ink-3 transition-colors duration-(--dur-1) hover:border-line-strong hover:text-ink"
        >
          <Icon name={link.icon} size={15} />
        </a>
      ))}
    </div>
  </div>
</aside>
