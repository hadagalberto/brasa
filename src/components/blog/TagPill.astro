---
/**
 * Tag pill — links to /blog/tags/<slug> when an href is given. Without one it
 * renders as a plain span: safe to use inside another link (e.g. prev/next
 * cards), where nesting anchors would be invalid HTML.
 */
interface Props {
  label: string;
  href?: string;
  /** Inactive context (e.g. the tags index) can opt out of hover affordance. */
  count?: number;
  class?: string;
}

const { label, href, count, class: className } = Astro.props;

const classes = [
  'inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 py-1 font-mono text-xs font-medium tracking-[0.04em] text-ink-2',
  href &&
    'transition-colors duration-(--dur-1) hover:border-accent/40 hover:bg-accent-soft hover:text-accent',
  className,
];
---

{href ? (
  <a href={href} class:list={classes}>
    {label}
    {count !== undefined && <span class="text-ink-3 tabular-nums">{count}</span>}
  </a>
) : (
  <span class:list={classes}>
    {label}
    {count !== undefined && <span class="text-ink-3 tabular-nums">{count}</span>}
  </span>
)}
