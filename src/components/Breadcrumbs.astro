---
/**
 * Breadcrumbs — the last crumb is the current page (aria-current), and the
 * trail is emitted as JSON-LD by the SEO component when passed through.
 */
import Icon from './Icon.astro';
import { normalizeLocale } from '../i18n';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const lang = normalizeLocale(Astro.currentLocale);
---

<nav aria-label={lang === 'pt-br' ? 'Trilha de navegação' : 'Breadcrumb'} class="not-prose">
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-ink-3">
    {items.map((item, index) => (
      <>
        {index > 0 && <Icon name="chevron-right" size={12} class="opacity-50" />}
        <li>
          {item.href ? (
            <a href={item.href} class="transition-colors duration-(--dur-1) hover:text-ink-2">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-2">
              {item.label}
            </span>
          )}
        </li>
      </>
    ))}
  </ol>
</nav>
