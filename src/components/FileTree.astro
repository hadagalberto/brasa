---
/**
 * FileTree — a static directory tree for MDX (project layouts, scaffold
 * explanations). Folders and files are plain semantic lists; depth is
 * expressed with padding, never with pixel-perfect connectors, so it stays
 * readable at any font size.
 */
import Icon from './Icon.astro';

export interface FileTreeItem {
  name: string;
  /** Nested entries (rendered with a folder marker). */
  children?: FileTreeItem[];
  /** Mono annotation shown at the end of the row, e.g. "added in 0.3.0". */
  note?: string;
  /** Small ember marker for entries the surrounding copy calls out. */
  highlight?: boolean;
}

interface Props {
  tree: FileTreeItem[];
  /** Visually hidden label for the tree. */
  label?: string;
  class?: string;
}

const { tree, label = 'Project files', class: className } = Astro.props;
---

<ul class:list={['filetree not-prose', className]} aria-label={label} data-pagefind-ignore>
  {tree.map(function render(item: FileTreeItem) {
    return (
      <li class="filetree-item" data-highlight={item.highlight ? '' : undefined}>
        <span class="filetree-row">
          <Icon
            name={item.children ? 'folder' : 'file'}
            size={15}
            class={item.children ? 'text-accent' : 'text-ink-3'}
          />
          <span class="filetree-name">{item.name}</span>
          {item.note && <span class="filetree-note">{item.note}</span>}
        </span>
        {item.children && <ul class="filetree-children">{item.children.map(render)}</ul>}
      </li>
    );
  })}
</ul>

<style>
  .filetree {
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background-color: var(--surface);
    padding: 1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.9;
    box-shadow: var(--elev-sm);
  }

  .filetree,
  .filetree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .filetree-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .filetree-name {
    color: var(--ink-2);
    font-weight: 500;
  }

  .filetree-item[data-highlight] .filetree-name {
    color: var(--ink);
  }

  .filetree-item[data-highlight] > .filetree-row::after {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background-image: var(--gradient-ember);
  }

  .filetree-note {
    margin-inline-start: auto;
    color: var(--ink-3);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-inline-start: 1.5rem;
  }

  .filetree-children {
    padding-inline-start: 1.375rem;
    border-inline-start: 1px solid var(--line);
    margin-block-start: 0.25rem;
    margin-inline-start: 0.4rem;
  }
</style>
