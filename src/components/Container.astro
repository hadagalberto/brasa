---
type Size = 'sm' | 'md' | 'lg' | 'xl' | 'full';

interface Props {
  size?: Size;
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;

const sizes: Record<Size, string> = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  full: 'max-w-none',
};
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className]}>
  <slot />
</div>
