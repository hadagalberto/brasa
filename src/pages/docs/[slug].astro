---
import { render } from 'astro:content';

import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsNeighbours, getDocs } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc, docs } }));
}

interface Props {
  doc: Awaited<ReturnType<typeof getDocs>>[number];
  docs: Awaited<ReturnType<typeof getDocs>>;
}

const { doc, docs } = Astro.props;
const { Content, headings } = await render(doc);
const { prev, next } = docsNeighbours(docs, doc);
---

<DocsLayout {doc} {docs} {headings} {prev} {next}>
  <Content />
</DocsLayout>
