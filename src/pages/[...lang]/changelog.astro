---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Container from '../../components/Container.astro';
import Icon from '../../components/Icon.astro';
import { getReleases } from '../../lib/changelog';
import { formatDate } from '../../lib/posts';
import { localizedPath, normalizeLocale, ui } from '../../i18n';
import { brasa } from '../../brasa.config';
import { withBase } from '../../lib/with-base';

export function getStaticPaths() {
  if (!brasa.features.changelog) return [];
  return [{ params: { lang: undefined } }, { params: { lang: 'pt-br' } }];
}

const lang = normalizeLocale(Astro.currentLocale);
const t = ui(lang);
const c = t.changelog;
const releases = await getReleases(lang);
---

<BaseLayout title={lang === 'pt-br' ? 'Novidades' : 'Changelog'} description={c.lede} {lang}>
  <div data-glow>
    <section>
      <Container
        size="md"
        class="pt-[calc(var(--header-h)+3.5rem)] pb-12 lg:pt-[calc(var(--header-h)+5rem)]"
      >
        <p class="eyebrow">
          <span class="eyebrow-dash" aria-hidden="true"></span>
          {c.eyebrow}
          <span class="eyebrow-dash" aria-hidden="true"></span>
        </p>
        <h1 class="mt-6 text-display-xl text-balance font-display text-ink">
          {c.title.before} <em class="text-gradient-ember italic">{c.title.em}</em> {c.title.after}
        </h1>
        <p class="mt-6 max-w-[62ch] text-pretty text-body-lg text-ink-2">{c.lede}</p>
        <div class="mt-8">
          <a
            href={withBase('rss.xml')}
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 px-4 py-2 font-mono text-xs text-ink-2 transition-colors duration-(--dur-1) hover:border-accent/40 hover:text-accent"
          >
            <Icon name="rss" size={14} />
            {c.feed}
          </a>
        </div>
      </Container>
    </section>
  </div>

  <Container size="md" class="pb-12">
    <ol class="relative space-y-4 border-s border-line ps-6 sm:ps-8">
      {releases.map((release, index) => (
        <li id={`v${release.data.version}`} class="relative scroll-mt-24">
          <span
            class:list={[
              'absolute -start-[1.6rem] top-7 size-3 rounded-full ring-4 ring-canvas sm:-start-[2.1rem]',
              index === 0 ? 'bg-ember-gradient shadow-glow' : 'bg-surface-3',
            ]}
            aria-hidden="true"
          ></span>
          <article
            class:list={[
              'rounded-2xl border p-6 shadow-sm sm:p-8',
              index === 0 ? 'border-accent/30 bg-surface' : 'border-line bg-surface/60',
            ]}
          >
            <div class="flex flex-wrap items-center gap-3">
              <Badge variant={index === 0 ? 'solid' : 'outline'}>v{release.data.version}</Badge>
              <time
                datetime={release.data.date.toISOString()}
                class="font-mono text-xs tracking-[0.06em] text-ink-3"
              >
                {formatDate(release.data.date, lang)}
              </time>
              {index === 0 && (
                <span class="font-mono text-[0.625rem] tracking-[0.12em] text-accent uppercase">
                  {lang === 'pt-br' ? 'mais recente' : 'latest'}
                </span>
              )}
            </div>

            <h2 class="mt-5 font-display text-display-sm text-balance text-ink">
              <a href={`#v${release.data.version}`} class="transition-colors hover:text-accent">
                {release.data.title}
              </a>
            </h2>
            <p class="mt-3 max-w-[68ch] text-pretty text-ink-2">{release.data.summary}</p>

            <div class="mt-7 grid grid-cols-1 gap-6 sm:grid-cols-2">
              {release.data.groups.map((group) => (
                <div>
                  <h3 class="font-mono text-[0.6875rem] font-medium tracking-[0.14em] text-accent uppercase">
                    {group.title}
                  </h3>
                  <ul class="mt-3 space-y-2.5">
                    {group.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-2">
                        <Icon name="check" size={14} class="mt-0.5 shrink-0 text-accent" />
                        <span class="text-pretty">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
      <p class="text-sm text-ink-3">
        {lang === 'pt-br'
          ? 'Usando o tema? Conte o que mudou para melhor.'
          : 'Using the theme? Tell us what got better.'}
      </p>
      <Button href={localizedPath('/contact', lang)} variant="secondary" icon="arrow-right">
        {lang === 'pt-br' ? 'Enviar uma nota' : 'Send a note'}
      </Button>
    </div>
  </Container>
</BaseLayout>
