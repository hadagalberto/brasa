<script>
  // Styleguide-only helpers: live token values + the accent hue demo.
  document.addEventListener('astro:page-load', () => {
    const refreshTokens = () => {
      document.querySelectorAll<HTMLElement>('[data-token]').forEach((element) => {
        const name = element.dataset.token;
        if (!name) return;
        element.textContent = getComputedStyle(element).getPropertyValue(name).trim() || '—';
      });
    };

    refreshTokens();

    const slider = document.querySelector<HTMLInputElement>('[data-hue-slider]');
    const output = document.querySelector<HTMLOutputElement>('[data-hue-value]');
    slider?.addEventListener('input', () => {
      document.documentElement.style.setProperty('--accent-hue', slider.value);
      if (output) output.textContent = slider.value;
      refreshTokens();
    });
  });
</script>
