---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Icon from '../../../components/Icon.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import TagPill from '../../../components/blog/TagPill.astro';
import {
  collectTags,
  getAuthor,
  getPosts,
  pageHref,
  paginate,
  pickFeatured,
  tagHref,
} from '../../../lib/posts';
import { localizedPath, normalizeLocale, ui } from '../../../i18n';
import { brasa } from '../../../brasa.config';
import { withBase } from '../../../lib/with-base';

export function getStaticPaths() {
  if (!brasa.features.blog) return [];
  return [{ params: { lang: undefined } }, { params: { lang: 'pt-br' } }];
}

const lang = normalizeLocale(Astro.currentLocale);
const t = ui(lang);
const b = t.blog.pages;

const posts = await getPosts(lang);
const featured = pickFeatured(posts);
const gridPosts = posts.filter((post) => post.id !== featured?.id);
const basePath = localizedPath('/blog', lang);
const { posts: pagePosts, page, totalPages } = paginate(gridPosts, 1, basePath);

const featuredAuthor = featured ? await getAuthor(featured.data.author, lang) : null;
const pageData = await Promise.all(
  pagePosts.map(async (post) => ({ post, author: await getAuthor(post.data.author, lang) })),
);
const tags = collectTags(posts).slice(0, 6);
---

<BaseLayout title={t.blog.allEssays} description={b.description} {lang}>
  <div class="section-y" data-glow>
    <Container size="md">
      <header class="flex flex-col gap-6" data-blog-hero>
        <p class="eyebrow">
          <span class="eyebrow-dash" aria-hidden="true"></span>
          {b.eyebrow}
        </p>
        <h1 class="font-display text-display-xl text-ink text-balance">
          {b.title.before} <em class="text-gradient-ember italic">{b.title.em}</em> {b.title.after}
        </h1>
        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">{b.lede}</p>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-ink-3 uppercase">
              {b.subscribe}
            </span>
            <a
              href={withBase('rss.xml')}
              class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 font-mono text-xs font-medium text-ink-2 transition-colors duration-(--dur-1) hover:border-accent/40 hover:bg-accent-soft hover:text-accent"
            >
              <Icon name="rss" size={13} />
              RSS
            </a>
            <a
              href={withBase('feed.json')}
              class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 font-mono text-xs font-medium text-ink-2 transition-colors duration-(--dur-1) hover:border-accent/40 hover:bg-accent-soft hover:text-accent"
            >
              <Icon name="code" size={13} />
              JSON
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-ink-3 uppercase">
              {b.topicsLabel}
            </span>
            {tags.map((tag) => (
              <TagPill label={tag.label} href={tagHref(tag.label, lang)} count={tag.count} />
            ))}
            <a
              href={localizedPath('/blog/tags', lang)}
              class="inline-flex h-8 items-center gap-1 rounded-full px-2 font-mono text-xs font-medium text-ink-3 transition-colors duration-(--dur-1) hover:text-ink"
            >
              {b.all}
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>
      </header>

      {featured && featuredAuthor && (
        <section aria-label={b.featuredLabel} class="mt-14">
          <PostCard post={featured} author={featuredAuthor} variant="featured" />
        </section>
      )}

      <section aria-label={b.latestLabel} class="mt-12">
        <h2 class="sr-only">{b.latestLabel}</h2>
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pageData.map(({ post, author }, index) => (
            <li>
              <PostCard post={post} author={author} index={index + 1} />
            </li>
          ))}
        </ul>
      </section>

      {totalPages > 1 && (
        <div class="mt-14">
          <Pagination
            page={page}
            totalPages={totalPages}
            hrefFor={(target) => pageHref(basePath, target)}
          />
        </div>
      )}
    </Container>
  </div>
</BaseLayout>
