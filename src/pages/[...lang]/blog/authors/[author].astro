---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Avatar from '../../../../components/Avatar.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Container from '../../../../components/Container.astro';
import Icon from '../../../../components/Icon.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { authorId, getAuthors, getPosts } from '../../../../lib/posts';
import { locales, localizedPath, normalizeLocale, ui } from '../../../../i18n';

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string | undefined; author: string } }> = [];
  for (const lang of locales) {
    const posts = await getPosts(lang);
    const ids = [...new Set(posts.map((post) => post.data.author))];
    paths.push(
      ...ids.map((id) => ({
        params: { lang: lang === 'en' ? undefined : lang, author: id },
      })),
    );
  }
  return paths;
}

const lang = normalizeLocale(Astro.currentLocale);
const t = ui(lang);
const { author: authorParam } = Astro.params;
const posts = await getPosts(lang);
const authors = await getAuthors(lang);
const authorEntry = authors.find((entry) => authorId(entry) === authorParam);
if (!authorEntry) {
  throw new Error(`Author page generated for unknown author "${authorParam}" (${lang})`);
}

const authorPosts = posts.filter((post) => post.data.author === authorParam);
const pageData = authorPosts.map((post) => ({ post, author: authorEntry }));
const { name, role, bio, location, links } = authorEntry.data;
---

<BaseLayout title={`${t.blog.allEssays} — ${name}`} description={`${role}. ${bio}`} {lang}>
  <div class="section-y" data-glow>
    <Container size="md">
      <Breadcrumbs
        items={[
          { label: lang === 'pt-br' ? 'Início' : 'Home', href: localizedPath('/', lang) },
          { label: t.blog.allEssays, href: localizedPath('/blog', lang) },
          { label: name },
        ]}
      />

      <header class="mt-8 flex flex-col gap-6">
        <div class="flex flex-wrap items-center gap-6 sm:items-center">
          <Avatar name={name} size={96} class="shadow-glow" />
          <div class="min-w-0">
            <p class="eyebrow">
              <span class="eyebrow-dash" aria-hidden="true"></span>
              {t.blog.pages.author.eyebrow}
            </p>
            <h1 class="mt-3 font-display text-display-lg text-ink text-balance">{name}</h1>
            <p class="mt-2 text-base font-medium text-accent">{role}</p>
          </div>
        </div>

        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">{bio}</p>

        <div class="flex flex-wrap items-center gap-4">
          {location && (
            <span class="inline-flex items-center gap-1.5 text-sm text-ink-3">
              <Icon name="globe" size={14} />
              {location}
            </span>
          )}
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name} — ${link.label}`}
              class="inline-flex size-9 items-center justify-center rounded-full border border-line text-ink-2 transition-colors duration-(--dur-1) hover:border-line-strong hover:text-ink"
            >
              <Icon name={link.icon} size={16} />
            </a>
          ))}
        </div>
      </header>

      <section aria-label={t.blog.postsBy(name)} class="mt-14">
        <h2 class="font-display text-display-sm text-ink">
          {t.blog.pages.author.count(authorPosts.length)}
        </h2>
        <ul class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pageData.map(({ post, author }, index) => (
            <li>
              <PostCard post={post} author={author} index={index + 1} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  </div>
</BaseLayout>
