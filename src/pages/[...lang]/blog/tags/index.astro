---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/Container.astro';
import TagPill from '../../../../components/blog/TagPill.astro';
import { collectTags, getPosts, tagHref } from '../../../../lib/posts';
import { normalizeLocale, ui } from '../../../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'pt-br' } }];
}

const lang = normalizeLocale(Astro.currentLocale);
const t = ui(lang);
const b = t.blog.pages;
const posts = await getPosts(lang);
const tags = collectTags(posts);
---

<BaseLayout
  title={`${t.blog.allTags} · ${t.blog.allEssays}`}
  description={b.tags.description}
  {lang}
>
  <div class="section-y" data-glow>
    <Container size="md">
      <header class="flex flex-col gap-5">
        <p class="eyebrow">
          <span class="eyebrow-dash" aria-hidden="true"></span>
          {b.tags.eyebrow}
        </p>
        <h1 class="font-display text-display-lg text-ink text-balance">{b.tags.title}</h1>
        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">
          {b.tags.lede(tags.length, posts.length)}
        </p>
      </header>

      <ul class="mt-12 flex flex-wrap gap-3" aria-label={b.tags.aria}>
        {tags.map((tag) => (
          <li>
            <TagPill
              label={tag.label}
              href={tagHref(tag.label, lang)}
              count={tag.count}
              class="h-10 px-4 text-sm"
            />
          </li>
        ))}
      </ul>
    </Container>
  </div>
</BaseLayout>
