---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFound from '../components/NotFound.astro';
import { ui } from '../i18n';
---

<!--
  Static hosts serve this file for every unknown path, including /pt-br/*.
  The inline script chooses the matching locale before paint so a Portuguese
  URL never lands on an English error page.
-->
<BaseLayout title={ui('en').notFound.title} noindex>
  <div data-locale="en">
    <NotFound lang="en" />
  </div>
  <div data-locale="pt-br" hidden>
    <NotFound lang="pt-br" />
  </div>
  <script is:inline>
    (() => {
      // Match the pt-br segment anywhere in the path: under a deploy base
      // path the URL is /brasa/pt-br/..., not /pt-br/....
      const portuguese = /(^|\/)pt-br(\/|$)/.test(window.location.pathname);
      const active = document.querySelector(
        portuguese ? '[data-locale="pt-br"]' : '[data-locale="en"]',
      );
      document.querySelectorAll('[data-locale]').forEach((node) => {
        if (node !== active) node.setAttribute('hidden', '');
        else node.removeAttribute('hidden');
      });
      if (portuguese) {
        document.documentElement.lang = 'pt-BR';
        document.title = 'Página não encontrada · Brasa';
        const description = document.querySelector('meta[name="description"]');
        if (description) {
          description.setAttribute(
            'content',
            'A página que você procura não existe — explore a documentação ou volte ao início.',
          );
        }
      }
    })();
  </script>
</BaseLayout>
