---
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import type { QA } from '../components/Accordion.astro';
import Avatar from '../components/Avatar.astro';
import Button from '../components/Button.astro';
import CodeTabs from '../components/CodeTabs.astro';
import type { CodeTab } from '../components/CodeTabs.astro';
import Container from '../components/Container.astro';
import CountUp from '../components/CountUp.astro';
import DashboardMock from '../components/DashboardMock.astro';
import Heading from '../components/Heading.astro';
import Icon from '../components/Icon.astro';
import LogoCloud from '../components/LogoCloud.astro';
import Marquee from '../components/Marquee.astro';
import PricingCard from '../components/PricingCard.astro';
import Section from '../components/Section.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import Steps from '../components/Steps.astro';
import type { Step } from '../components/Steps.astro';
import Testimonial from '../components/Testimonial.astro';
import { brasa } from '../brasa.config';

/* ------------------------------ Demo content ------------------------------ */
/* Brasa Cloud — the fictional product this theme demos (see SPEC): deploy
   previews for teams. All copy below is realistic demo copy. */

const howItWorks: Step[] = [
  {
    icon: 'git-branch',
    title: 'Connect your repo',
    body: 'Link GitHub or GitLab in two clicks. Brasa Cloud detects your framework, build graph and environment variables — then never asks again.',
  },
  {
    icon: 'bolt',
    title: 'Push a branch',
    body: 'Every push triggers an isolated build on shared runners. Logs stream live, and failures point at the exact commit — not the pipeline.',
  },
  {
    icon: 'link',
    title: 'Share the preview',
    body: 'Grab the link, drop it in Slack or the pull request. Comments collect in context, and you merge when it feels right.',
  },
];

const codeTabs: CodeTab[] = [
  {
    id: 'cli',
    label: 'CLI',
    icon: 'terminal',
    lang: 'bash',
    title: 'terminal',
    code: [
      '# log in once per machine',
      'npx brasa-cloud login',
      '',
      '# deploy the branch you are on',
      'brasa deploy --branch feat/ember-glow',
      '# built in 6.2s -> https://preview-8f2k.brasa.cloud',
      '',
      '# tail any running preview',
      'brasa logs --follow',
    ].join('\n'),
  },
  {
    id: 'config',
    label: 'Config',
    icon: 'sliders',
    lang: 'ts',
    title: 'brasa.config.ts',
    code: [
      "import { defineConfig } from 'brasa-cloud';",
      '',
      'export default defineConfig({',
      "  project: 'brasa/site',",
      "  regions: ['gru', 'iad', 'fra'],",
      "  cache: { strategy: 'content-addressed' },",
      '  previews: {',
      "    retention: '30d',",
      "    auth: 'team-sso',",
      '    outsidePasswords: true,',
      '  },',
      '});',
    ].join('\n'),
  },
  {
    id: 'api',
    label: 'API',
    icon: 'code',
    lang: 'bash',
    title: 'api.brasa.cloud',
    code: [
      'curl -X POST https://api.brasa.cloud/v1/previews \\',
      '  -H "Authorization: Bearer $BRASA_TOKEN" \\',
      '  -H "Content-Type: application/json" \\',
      '  -d \'{"branch":"feat/ember-glow"}\'',
      '',
      '# 201 Created',
      '# {"url":"https://preview-8f2k.brasa.cloud","buildMs":6210}',
    ].join('\n'),
  },
];

const testimonials = [
  {
    quote:
      'Review cycles went from a day to an afternoon. Designers finally comment on the real thing instead of screenshots.',
    name: 'Marina Cole',
    role: 'Head of Engineering, Alto Labs',
  },
  {
    quote: 'We stopped saying “works on my machine”. The preview is the meeting now.',
    name: 'Ravi Nair',
    role: 'Staff Engineer, Fjord & Co',
  },
  {
    quote: 'The cache is honestly rude. Our 400-page docs site rebuilds in seconds flat.',
    name: 'June Park',
    role: 'Documentation Lead, Cadence',
  },
  {
    quote: 'SSO plus per-branch passwords meant legal stopped saying no to sharing builds.',
    name: 'Tomás Vieira',
    role: 'Platform Lead, Kilnworks',
  },
  {
    quote: 'Clients click one warm link and feel the site before we send an invoice.',
    name: 'Anna Sørensen',
    role: 'Partner, Studio Halfmoon',
  },
  {
    quote: 'The first deploy tool our designers open on purpose. That says everything.',
    name: 'Diego Fuentes',
    role: 'Design Director, Northloop',
  },
] as const;

const tiers = [
  {
    name: 'Starter',
    price: '$0',
    unit: 'forever',
    blurb: 'Public repos, weekend experiments, the side project you still believe in.',
    features: [
      'Unlimited public previews',
      '2 concurrent builds',
      'GitHub & GitLab apps',
      'Community support',
    ],
    ctaLabel: 'Start for free',
    ctaHref: '#get-started',
    featured: false,
  },
  {
    name: 'Team',
    price: '$12',
    unit: 'per seat / month',
    blurb: 'For product teams that open a preview before they open a pull request.',
    features: [
      'Everything in Starter',
      'Private previews with SSO',
      'Slack app + notifications',
      '30-day preview retention',
    ],
    ctaLabel: 'Try 14 days free',
    ctaHref: '#get-started',
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    unit: '',
    blurb: 'For platform teams with audit trails, their own regions and a phone number.',
    features: [
      'Everything in Team',
      'SAML SSO + audit logs',
      'Dedicated build regions',
      'Priority queue with SLA',
    ],
    ctaLabel: 'Talk to us',
    ctaHref: '#get-started',
    featured: false,
  },
] as const;

const faqs: QA[] = [
  {
    q: 'How is this different from the previews our CI already generates?',
    a: 'CI artifacts are static bundles you download and host yourself. Brasa previews are running sites: built, seeded with realistic data, guarded by your SSO and served from the region closest to your reviewer. No curling tarballs, no guessing which artifact is newest.',
  },
  {
    q: 'Can people outside our SSO see a preview?',
    a: 'Yes — issue a per-branch password from the dashboard or the CLI. It works for one branch, expires when the branch merges, and you can revoke it in a single click. Outside reviewers never touch your production auth.',
  },
  {
    q: 'What happens when a branch is merged or deleted?',
    a: 'The preview is garbage-collected within the hour, and its URL returns a warm, branded “this branch merged” page instead of a hard 404. Links in old pull requests keep telling the right story.',
  },
  {
    q: 'Do preview builds burn our CI minutes?',
    a: 'No. Builds run on Brasa’s isolated runners, sized per framework, with content-addressed caching that skips anything your last build already produced. Your CI keeps doing what it does best: tests.',
  },
  {
    q: 'Can we self-host Brasa Cloud?',
    a: 'Enterprise plans run single-tenant images inside your own VPC, with your object storage and your SSO. The open-source heart of the platform — including the theme you are looking at — stays MIT.',
  },
];

const installCommand = 'npm create astro@latest -- --template hadagalberto/brasa';
---

<BaseLayout title="Brasa" description={brasa.site.description}>
  {/* ------------------------------- Hero --------------------------------- */}
  <section data-glow class="relative overflow-hidden">
    <Container
      size="xl"
      class="pt-[calc(var(--header-h)+3.75rem)] pb-20 lg:pt-[calc(var(--header-h)+5.5rem)] lg:pb-28"
    >
      <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-[7fr_6fr] lg:gap-16 xl:gap-20">
        <div>
          <p class="eyebrow">
            <span class="eyebrow-dash" aria-hidden="true"></span>
            Brasa Cloud · deploy previews for teams
          </p>
          <h1 class="mt-7 text-hero text-balance font-sans text-ink">
            Every push, a <em class="font-display text-gradient-ember italic">living</em> preview.
          </h1>
          <p class="mt-7 max-w-[54ch] text-pretty text-body-lg text-ink-2">
            Brasa Cloud turns each branch into a fast, shareable site — SSO-guarded, cache-smart and
            live before your coffee cools. Point your team at a URL, not a screenshot.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <Button href="#how-it-works" size="lg" icon="arrow-right">
              See it in action
            </Button>
            <Button
              href={brasa.site.github}
              variant="secondary"
              size="lg"
              iconStart="github"
              target="_blank"
              rel="noopener noreferrer"
            >
              Star on GitHub
            </Button>
          </div>
          <p class="mt-7 font-mono text-xs tracking-[0.08em] text-ink-3">
            free for public repos · no credit card · two-minute setup
          </p>
        </div>

        <div>
          <DashboardMock class="w-full" />
        </div>
      </div>

      <LogoCloud caption="Powering weekly release trains at" class="mt-20 lg:mt-28" />
    </Container>
  </section>

  {/* ------------------------------- Bento -------------------------------- */}
  <Section id="features">
    <Container size="xl">
      <div class="reveal">
        <Heading
          eyebrow="Why Brasa Cloud"
          as="h2"
          size="display-lg"
          lede="Six cards, the whole story — everything that happens between your last git push and a merge you can trust."
        >
          <Fragment slot="title">
            Previews that pull their
            <em class="text-gradient-ember italic">weight</em>.
          </Fragment>
        </Heading>
      </div>

      <ul class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-6">
        <li class="md:col-span-3 md:row-span-2">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="link" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">A URL for every branch</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              Each push gets a stable link that stays warm for the life of the branch. Reviewers
              land on the exact change — never on main, never on a zip file.
            </p>
            <div class="mt-auto space-y-2.5 pt-8" aria-hidden="true">
              <div class="flex items-center gap-3 rounded-lg border border-line bg-surface-2/60 px-3.5 py-2.5 font-mono text-xs">
                <span class="size-2 shrink-0 rounded-full bg-ember-gradient"></span>
                <span class="w-0 min-w-0 flex-1 truncate text-ink-2">
                  preview-8f2k<span class="text-ink-3"> · feat/ember-glow</span>
                </span>
                <span class="shrink-0 font-mono text-[10px] tracking-[0.12em] text-accent uppercase">
                  live
                </span>
              </div>
              <div class="flex items-center gap-3 rounded-lg border border-line bg-surface-2/60 px-3.5 py-2.5 font-mono text-xs">
                <span
                  class="size-2 shrink-0 rounded-full"
                  style="background: oklch(0.75 0.14 70)"
                ></span>
                <span class="w-0 min-w-0 flex-1 truncate text-ink-2">
                  preview-q7mn<span class="text-ink-3"> · fix/header-blur</span>
                </span>
                <span class="shrink-0 font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase">
                  building
                </span>
              </div>
              <div class="flex items-center gap-3 rounded-lg border border-line bg-surface-2/60 px-3.5 py-2.5 font-mono text-xs">
                <span class="size-2 shrink-0 rounded-full bg-ink-3/60"></span>
                <span class="w-0 min-w-0 flex-1 truncate text-ink-2">
                  brasa.cloud<span class="text-ink-3"> · main</span>
                </span>
                <span class="shrink-0 font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase">
                  production
                </span>
              </div>
            </div>
          </SpotlightCard>
        </li>

        <li class="md:col-span-3">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="chart" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">Cache that actually hits</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              Content-addressed caching restores everything that didn’t change. A 400-route site
              rebuilds in seconds, not coffee breaks.
            </p>
            <div class="mt-auto pt-7" aria-hidden="true">
              <div class="flex h-2 overflow-hidden rounded-full border border-line bg-surface-2">
                <div class="h-full w-[97%] bg-ember-gradient"></div>
              </div>
              <div class="mt-2.5 flex justify-between font-mono text-[10px] text-ink-3">
                <span class="text-accent">cache hit 97%</span>
                <span>rebuild 6.2s</span>
              </div>
            </div>
          </SpotlightCard>
        </li>

        <li class="md:col-span-3">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="shield" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">Guarded by default</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              Previews sit behind your team’s SSO. Need outside eyes? Issue a per-branch password
              and revoke it with a click.
            </p>
            <div class="mt-auto flex flex-wrap gap-2 pt-7" aria-hidden="true">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2/60 px-3 py-1.5 font-mono text-[10px] tracking-[0.08em] text-ink-2 uppercase">
                <Icon name="shield" size={11} class="text-accent" /> SSO · Okta
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2/60 px-3 py-1.5 font-mono text-[10px] tracking-[0.08em] text-ink-2 uppercase">
                <Icon name="lock" size={11} class="text-accent" /> branch password
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2/60 px-3 py-1.5 font-mono text-[10px] tracking-[0.08em] text-ink-2 uppercase">
                <Icon name="rotate-ccw" size={11} class="text-accent" /> revoked 2h ago
              </span>
            </div>
          </SpotlightCard>
        </li>

        <li class="md:col-span-2">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="message" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">Comments in context</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              Designers and PMs comment on the preview itself. Feedback lands where the change
              lives, not three tools away.
            </p>
            <div class="mt-auto pt-7" aria-hidden="true">
              <div class="flex items-start gap-2.5">
                <Avatar name="Marina Cole" size={22} />
                <p class="rounded-lg rounded-tl-sm border border-line bg-surface-2 px-3 py-2 text-xs text-ink-2">
                  Hero glow is perfect. Ship it.
                </p>
              </div>
              <p class="mt-2 flex items-center gap-1.5 pl-8 font-mono text-[10px] text-ink-3">
                <Icon name="check" size={11} class="text-accent" /> 2 approvals · merged 14:02
              </p>
            </div>
          </SpotlightCard>
        </li>

        <li class="md:col-span-2">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="rotate-ccw" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">One-click rollbacks</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              Every deploy is a snapshot. Restore any preview or production state instantly — no git
              archaeology required.
            </p>
            <div class="mt-auto pt-7" aria-hidden="true">
              <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2/60 px-3.5 py-2 font-mono text-[10px] tracking-[0.06em] text-ink-2">
                <Icon name="rotate-ccw" size={12} class="text-accent" />
                v142 → v138 · 4s · zero downtime
              </p>
            </div>
          </SpotlightCard>
        </li>

        <li class="md:col-span-2">
          <SpotlightCard class="reveal flex h-full flex-col p-6 sm:p-7">
            <Icon name="bell" size={22} class="text-accent" />
            <h3 class="mt-5 font-display text-display-sm text-ink">Slack, where you already are</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2 text-pretty">
              The bot posts the preview the moment it’s live. Threads, approvals and reactions stay
              where your team already talks.
            </p>
            <div class="mt-auto pt-7" aria-hidden="true">
              <p class="rounded-lg rounded-tl-sm border border-line bg-surface-2 px-3 py-2.5 font-mono text-[11px]">
                <span class="text-accent">brasa</span>
                <span class="text-ink-3"> · </span>
                <span class="text-ink-2">Preview ready — feat/ember-glow · 6.2s</span>
              </p>
            </div>
          </SpotlightCard>
        </li>
      </ul>
    </Container>
  </Section>

  {/* --------------------------- How it works ------------------------------ */}
  <Section id="how-it-works" tone="surface">
    <Container size="lg">
      <div class="reveal">
        <Heading
          eyebrow="How it works"
          as="h2"
          size="display-lg"
          lede="Brasa Cloud plugs into the repository you already have. No YAML archaeology, nothing new to teach the team."
        >
          <Fragment slot="title">
            Three moves. No new
            <em class="text-gradient-ember italic">workflow</em>.
          </Fragment>
        </Heading>
      </div>

      <div class="reveal mt-14">
        <Steps steps={howItWorks} />
      </div>
    </Container>
  </Section>

  {/* ----------------------------- Code tabs ------------------------------- */}
  <Section id="code">
    <Container size="lg">
      <div class="reveal">
        <Heading
          eyebrow="Interface"
          as="h2"
          size="display-lg"
          align="center"
          lede="The same platform behind three idioms — pick the one your workflow already speaks, or wire all three into CI."
        >
          <Fragment slot="title">
            Three ways to <em class="text-gradient-ember italic">ship</em>.
          </Fragment>
        </Heading>
      </div>

      <div class="reveal mt-12">
        <CodeTabs tabs={codeTabs} label="Ways to deploy" class="mx-auto max-w-3xl" />
      </div>
    </Container>
  </Section>

  {/* ------------------------------ Metrics -------------------------------- */}
  <Section id="metrics" tone="deep">
    <Container size="xl">
      <h2 class="sr-only">Brasa Cloud in numbers</h2>
      <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-4">
        <CountUp value={41} suffix="k+" label="previews served weekly" sub="across three regions" />
        <CountUp
          value={99.98}
          decimals={2}
          suffix="%"
          label="preview uptime"
          sub="trailing twelve months"
        />
        <CountUp
          value={4.6}
          decimals={1}
          suffix="s"
          label="median push-to-live"
          sub="p50, all frameworks"
        />
        <CountUp
          value={132}
          label="teams shipping daily"
          sub="from two-person studios to platform orgs"
        />
      </div>
    </Container>
  </Section>

  {/* ---------------------------- Testimonials ------------------------------ */}
  <Section id="testimonials">
    <Container size="xl">
      <div class="reveal">
        <Heading
          eyebrow="Testimonials"
          as="h2"
          size="display-lg"
          align="center"
          lede="Six of the teams shipping with Brasa Cloud every day — hover or focus the row to pause it."
        >
          <Fragment slot="title">
            Teams that stopped <em class="text-gradient-ember italic">waiting</em> on review.
          </Fragment>
        </Heading>
      </div>

      <Marquee label="What teams say about Brasa Cloud" class="mt-14" speed={44}>
        {testimonials.map((testimonial) => (
          <Testimonial quote={testimonial.quote} name={testimonial.name} role={testimonial.role} />
        ))}
      </Marquee>
    </Container>
  </Section>

  {/* --------------------------- Pricing teaser ----------------------------- */}
  <Section id="pricing" tone="surface">
    <Container size="xl">
      <div class="reveal">
        <Heading
          eyebrow="Pricing"
          as="h2"
          size="display-lg"
          lede="Every plan ships unlimited public previews — the difference is who needs to look at the private ones."
        >
          <Fragment slot="title">
            Start free. Pay when the team <em class="text-gradient-ember italic">grows</em>.
          </Fragment>
        </Heading>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-3">
        {tiers.map((tier) => (
          <div class="reveal">
            <PricingCard
              name={tier.name}
              price={tier.price}
              unit={tier.unit}
              blurb={tier.blurb}
              features={[...tier.features]}
              ctaLabel={tier.ctaLabel}
              ctaHref={tier.ctaHref}
              featured={tier.featured}
            />
          </div>
        ))}
      </div>

      <p class="reveal mt-8 text-center text-sm text-ink-3">
        Plans, seats, limits and invoicing are covered in the
        <a
          href="#faq"
          class="ml-1 font-medium text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-(--dur-1) hover:decoration-accent"
        >
          FAQ below
        </a>
        .
      </p>
    </Container>
  </Section>

  {/* -------------------------------- FAQ ---------------------------------- */}
  <Section id="faq">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="FAQ"
          as="h2"
          size="display-lg"
          lede="Five minutes of reading before you write to support — or to procurement."
        >
          <Fragment slot="title">
            The questions <em class="text-gradient-ember italic">procurement</em> always asks.
          </Fragment>
        </Heading>
      </div>

      <Accordion items={faqs} class="reveal mt-12" />
    </Container>
  </Section>

  {/* ------------------------------ Final CTA ------------------------------ */}
  <Section id="get-started" tone="deep">
    <div data-glow class="relative overflow-hidden">
      <Container size="md" class="py-4 text-center">
        <div class="reveal flex flex-col items-center">
          <p class="eyebrow">
            <span class="eyebrow-dash" aria-hidden="true"></span>
            Get started
            <span class="eyebrow-dash" aria-hidden="true"></span>
          </p>
          <h2 class="mt-6 max-w-[16ch] text-display-xl text-balance font-display text-ink">
            Give every branch somewhere to
            <em class="text-gradient-ember italic">glow</em>.
          </h2>
          <p class="mt-6 max-w-[52ch] text-pretty text-body-lg text-ink-2">
            This page is the Brasa theme’s home demo — one accent hue in one config file away from
            being yours. MIT-licensed, self-host-friendly, zero JS frameworks.
          </p>

          <div class="mt-9 inline-flex max-w-full items-center gap-2 rounded-full border border-line bg-surface-2/70 py-2 pl-5 pr-2.5 shadow-sm">
            <code class="w-0 min-w-0 flex-1 truncate font-mono text-[0.8125rem] text-ink-2">
              <span class="select-none text-ink-3" aria-hidden="true">
                $&nbsp;
              </span>
              <span id="install-command">{installCommand}</span>
            </code>
            <button
              type="button"
              data-copy="install-command"
              aria-label="Copy install command to clipboard"
              class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line bg-surface-3 text-ink-2 transition-colors duration-(--dur-1) hover:border-line-strong hover:text-ink"
            >
              <Icon name="copy" size={14} class="icon-copy" />
              <Icon name="check" size={14} class="icon-check" strokeWidth={2.6} />
              <span class="sr-only" data-copy-feedback aria-live="polite"></span>
            </button>
          </div>

          <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
            <Button
              href={brasa.site.github}
              size="lg"
              iconStart="github"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get the theme — it’s MIT
            </Button>
            <Button href="/styleguide" variant="secondary" size="lg" icon="arrow-right">
