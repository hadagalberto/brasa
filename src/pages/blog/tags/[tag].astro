---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Container from '../../../components/Container.astro';
import Icon from '../../../components/Icon.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getAuthor, getPosts, tagSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, number>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.set(tag, (tags.get(tag) ?? 0) + 1);
    }
  }
  return [...tags.keys()].map((tag) => ({ params: { tag: tagSlug(tag) } }));
}

const { tag: tagParam } = Astro.params;
const posts = await getPosts();
const tagged = posts.filter((post) => post.data.tags.some((tag) => tagSlug(tag) === tagParam));
const label = tagged[0]?.data.tags.find((tag) => tagSlug(tag) === tagParam) ?? '';

const pageData = await Promise.all(
  tagged.map(async (post) => ({ post, author: await getAuthor(post.data.author) })),
);
---

<BaseLayout
  title={`Blog — ${label}`}
  description={`Every essay on the Brasa blog tagged “${label}”.`}
>
  <div class="section-y" data-glow>
    <Container size="md">
      <Breadcrumbs
        items={[
          { label: 'Home', href: `${import.meta.env.BASE_URL}` },
          { label: 'Blog', href: `${import.meta.env.BASE_URL}blog` },
          { label: 'Topics', href: `${import.meta.env.BASE_URL}blog/tags` },
          { label },
        ]}
      />

      <header class="mt-8 flex flex-col gap-5">
        <p class="eyebrow">
          <Icon name="tag" size={13} />
          Topic
        </p>
        <h1 class="font-display text-display-lg text-ink text-balance">{label}</h1>
        <p class="text-pretty text-body-lg text-ink-2">
          {tagged.length}
          {tagged.length === 1 ? 'essay' : 'essays'}, newest first.
        </p>
      </header>

      <section aria-label={`Essays tagged ${label}`} class="mt-12">
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pageData.map(({ post, author }, index) => (
            <li>
              <PostCard post={post} author={author} index={index + 1} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  </div>
</BaseLayout>
