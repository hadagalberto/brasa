---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Icon from '../../components/Icon.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagPill from '../../components/blog/TagPill.astro';
import {
  collectTags,
  getAuthor,
  getPosts,
  pageHref,
  paginate,
  pickFeatured,
  tagHref,
} from '../../lib/posts';

const posts = await getPosts();
const featured = pickFeatured(posts);
const gridPosts = posts.filter((post) => post.id !== featured?.id);
const { posts: pagePosts, page, totalPages } = paginate(gridPosts, 1);

const featuredAuthor = featured ? await getAuthor(featured.data.author) : null;
const pageData = await Promise.all(
  pagePosts.map(async (post) => ({ post, author: await getAuthor(post.data.author) })),
);
const tags = collectTags(posts).slice(0, 6);

const basePath = `${import.meta.env.BASE_URL}blog`;
---

<BaseLayout
  title="Blog"
  description="Notes from the forge — essays on deploy previews, performance, accessibility and design systems, from the team building the Brasa theme."
>
  <div class="section-y" data-glow>
    <Container size="md">
      <header class="flex flex-col gap-6" data-blog-hero>
        <p class="eyebrow">
          <span class="eyebrow-dash" aria-hidden="true"></span>
          The forge · essays
        </p>
        <h1 class="font-display text-display-xl text-ink text-balance">
          Notes from the <em class="text-gradient-ember italic">forge</em>
        </h1>
        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">
          Essays on deploy previews, performance, accessibility and design
          systems — written while building the Brasa theme, with the receipts
          attached.
        </p>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-ink-3 uppercase">
              Subscribe
            </span>
            <a
              href={`${import.meta.env.BASE_URL}rss.xml`}
              class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 font-mono text-xs font-medium text-ink-2 transition-colors duration-(--dur-1) hover:border-accent/40 hover:bg-accent-soft hover:text-accent"
            >
              <Icon name="rss" size={13} />
              RSS
            </a>
            <a
              href={`${import.meta.env.BASE_URL}feed.json`}
              class="inline-flex h-8 items-center gap-1.5 rounded-full border border-line bg-surface-2 px-3 font-mono text-xs font-medium text-ink-2 transition-colors duration-(--dur-1) hover:border-accent/40 hover:bg-accent-soft hover:text-accent"
            >
              <Icon name="code" size={13} />
              JSON
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-ink-3 uppercase">
              Topics
            </span>
            {tags.map((tag) => (
              <TagPill label={tag.label} href={tagHref(tag.label)} count={tag.count} />
            ))}
            <a
              href={`${import.meta.env.BASE_URL}blog/tags`}
              class="inline-flex h-8 items-center gap-1 rounded-full px-2 font-mono text-xs font-medium text-ink-3 transition-colors duration-(--dur-1) hover:text-ink"
            >
              all
              <Icon name="arrow-right" size={13} />
            </a>
          </div>
        </div>
      </header>

      {
        featured && featuredAuthor && (
          <section aria-label="Featured essay" class="mt-14">
            <PostCard post={featured} author={featuredAuthor} variant="featured" />
          </section>
        )
      }

      <section aria-label="Latest essays" class="mt-12">
        <h2 class="sr-only">Latest essays</h2>
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            pageData.map(({ post, author }, index) => (
              <li>
                <PostCard post={post} author={author} index={index + 1} />
              </li>
            ))
          }
        </ul>
      </section>

      {
        totalPages > 1 && (
          <div class="mt-14">
            <Pagination
              page={page}
              totalPages={totalPages}
              hrefFor={(target) => pageHref(basePath, target)}
            />
          </div>
        )
      }
    </Container>
  </div>
</BaseLayout>
