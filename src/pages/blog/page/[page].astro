---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Icon from '../../../components/Icon.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getAuthor, getPosts, pageHref, paginate, pickFeatured, PAGE_SIZE } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const featured = pickFeatured(posts);
  const gridPosts = posts.filter((post) => post.id !== featured?.id);
  const totalPages = Math.max(1, Math.ceil(gridPosts.length / PAGE_SIZE));
  return Array.from({ length: totalPages }, (_, index) => index + 1)
    .filter((page) => page > 1)
    .map((page) => ({ params: { page: String(page) } }));
}

const { page: pageParam } = Astro.params;
const page = Number(pageParam ?? '1');

const posts = await getPosts();
const featured = pickFeatured(posts);
const gridPosts = posts.filter((post) => post.id !== featured?.id);
const { posts: pagePosts, totalPages } = paginate(gridPosts, page);

const pageData = await Promise.all(
  pagePosts.map(async (post) => ({ post, author: await getAuthor(post.data.author) })),
);

const basePath = `${import.meta.env.BASE_URL}blog`;
---

<BaseLayout
  title={`Blog — page ${page}`}
  description="Notes from the forge — essays on deploy previews, performance, accessibility and design systems, from the team building the Brasa theme."
>
  <div class="section-y" data-glow>
    <Container size="md">
      <header class="flex flex-col gap-5">
        <p class="eyebrow">
          <span class="eyebrow-dash" aria-hidden="true"></span>
          The forge · archive
        </p>
        <h1 class="font-display text-display-lg text-ink text-balance">
          Notes from the forge
          <span class="text-ink-3">
            — page <span class="text-accent tabular-nums">{page}</span> of {totalPages}
          </span>
        </h1>
        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">
          The archive, newest first. The front page keeps the featured essay
          and the latest six.
        </p>
        <a
          href={basePath}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-2 transition-colors duration-(--dur-1) hover:text-ink"
        >
          <Icon name="chevron-left" size={15} />
          Back to the front page
        </a>
      </header>

      <section aria-label={`Essays, page ${page}`} class="mt-12">
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            pageData.map(({ post, author }, index) => (
              <li>
                <PostCard post={post} author={author} index={index + 1} />
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-14">
        <Pagination
          {page}
          {totalPages}
          hrefFor={(target) => pageHref(basePath, target)}
        />
      </div>
    </Container>
  </div>
</BaseLayout>
