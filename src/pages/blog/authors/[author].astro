---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Container from '../../../components/Container.astro';
import Icon from '../../../components/Icon.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const authorIds = [...new Set(posts.map((post) => post.data.author))];
  return authorIds.map((id) => ({ params: { author: id } }));
}

const { author: authorParam } = Astro.params;
const posts = await getPosts();
const authors = await getCollection('authors');

// getStaticPaths only generates authors with posts, so a miss means the
// data files drifted from the frontmatter — fail loudly at build time.
const authorEntry = authors.find((entry) => entry.id === authorParam);
if (!authorEntry) {
  throw new Error(`Author page generated for unknown author "${authorParam}"`);
}

const authorPosts = posts.filter((post) => post.data.author === authorParam);
const pageData = authorPosts.map((post) => ({ post, author: authorEntry }));
const { name, role, bio, location, links } = authorEntry.data;
---

<BaseLayout title={`Blog — ${name}`} description={`${role}. ${bio}`}>
  <div class="section-y" data-glow>
    <Container size="md">
      <Breadcrumbs
        items={[
          { label: 'Home', href: `${import.meta.env.BASE_URL}` },
          { label: 'Blog', href: `${import.meta.env.BASE_URL}blog` },
          { label: name },
        ]}
      />

      <header class="mt-8 flex flex-col gap-6">
        <div class="flex flex-wrap items-center gap-6 sm:items-center">
          <Avatar name={name} size={96} class="shadow-glow" />
          <div class="min-w-0">
            <p class="eyebrow">
              <span class="eyebrow-dash" aria-hidden="true"></span>
              Author
            </p>
            <h1 class="mt-3 font-display text-display-lg text-ink text-balance">{name}</h1>
            <p class="mt-2 text-base font-medium text-accent">{role}</p>
          </div>
        </div>

        <p class="max-w-[62ch] text-pretty text-body-lg text-ink-2">{bio}</p>

        <div class="flex flex-wrap items-center gap-4">
          {location && (
            <span class="inline-flex items-center gap-1.5 text-sm text-ink-3">
              <Icon name="globe" size={14} />
              {location}
            </span>
          )}
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name} on ${link.label}`}
              class="inline-flex size-9 items-center justify-center rounded-full border border-line text-ink-2 transition-colors duration-(--dur-1) hover:border-line-strong hover:bg-surface hover:text-ink"
            >
              <Icon name={link.icon} size={16} />
            </a>
          ))}
        </div>
      </header>

      <section aria-label={`Essays by ${name}`} class="mt-14">
        <h2 class="font-display text-display-sm text-ink">
          {authorPosts.length === 1 ? 'Their essay' : `All ${authorPosts.length} essays`}
        </h2>
        <ul class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pageData.map(({ post, author }, index) => (
            <li>
              <PostCard post={post} author={author} index={index + 1} />
            </li>
          ))}
        </ul>
      </section>
    </Container>
  </div>
</BaseLayout>
