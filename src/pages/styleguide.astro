---
import { Code } from 'astro-expressive-code/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import Prose from '../components/Prose.astro';
import Section from '../components/Section.astro';
import SpotlightCard from '../components/SpotlightCard.astro';

/* ------------------------------ Token data ------------------------------ */

const semanticTokens: { name: string; css: string }[] = [
  { name: 'canvas', css: '--canvas' },
  { name: 'canvas-deep', css: '--canvas-deep' },
  { name: 'surface', css: '--surface' },
  { name: 'surface-2', css: '--surface-2' },
  { name: 'surface-3', css: '--surface-3' },
  { name: 'ink', css: '--ink' },
  { name: 'ink-2', css: '--ink-2' },
  { name: 'ink-3', css: '--ink-3' },
  { name: 'line', css: '--line' },
  { name: 'line-strong', css: '--line-strong' },
  { name: 'accent', css: '--accent' },
  { name: 'accent-2', css: '--accent-2' },
  { name: 'on-accent', css: '--on-accent' },
];

const emberSteps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] as const;

const typeScale: { name: string; classes: string; sample: string }[] = [
  {
    name: 'hero',
    classes: 'font-sans font-semibold text-hero',
    sample: 'Sites that still glow',
  },
  {
    name: 'display-2xl',
    classes: 'font-display text-display-2xl',
    sample: 'Deploy previews for teams',
  },
  {
    name: 'display-xl',
    classes: 'font-display text-display-xl',
    sample: 'Deploy previews for teams',
  },
  {
    name: 'display-lg',
    classes: 'font-display text-display-lg',
    sample: 'Deploy previews for teams',
  },
  {
    name: 'display-md',
    classes: 'font-display text-display-md',
    sample: 'Deploy previews for teams',
  },
  {
    name: 'display-sm',
    classes: 'font-display text-display-sm',
    sample: 'Deploy previews for teams',
  },
  {
    name: 'body-lg',
    classes: 'text-body-lg',
    sample: 'Body copy is set in Geist at a fluid size with generous leading.',
  },
  {
    name: 'body',
    classes: 'text-base',
    sample: 'Secondary body copy inherits the base 1rem size and a 1.75 rhythm.',
  },
  {
    name: 'mono',
    classes: 'font-mono text-sm',
    sample: 'const ember = oklch(0.685 0.19 35);',
  },
];

const spacingSteps: { label: string; classes: string }[] = [
  { label: '0.5rem', classes: 'w-2' },
  { label: '1rem', classes: 'w-4' },
  { label: '1.5rem', classes: 'w-6' },
  { label: '2rem', classes: 'w-8' },
  { label: '3rem', classes: 'w-12' },
  { label: '4rem', classes: 'w-16' },
  { label: '6rem', classes: 'w-24' },
];

const radii: { name: string; classes: string }[] = [
  { name: 'xs', classes: 'rounded-xs' },
  { name: 'sm', classes: 'rounded-sm' },
  { name: 'md', classes: 'rounded-md' },
  { name: 'lg', classes: 'rounded-lg' },
  { name: 'xl', classes: 'rounded-xl' },
  { name: '2xl', classes: 'rounded-2xl' },
  { name: '3xl', classes: 'rounded-3xl' },
];

const shadows: { name: string; classes: string }[] = [
  { name: 'shadow-sm', classes: 'shadow-sm' },
  { name: 'shadow-md', classes: 'shadow-md' },
  { name: 'shadow-lg', classes: 'shadow-lg' },
  { name: 'shadow-glow', classes: 'shadow-glow' },
];

const iconNames: IconName[] = [
  'flame',
  'sun',
  'moon',
  'menu',
  'close',
  'arrow-right',
  'arrow-up-right',
  'chevron-down',
  'chevron-right',
  'check',
  'search',
  'terminal',
  'code',
  'book',
  'copy',
  'mail',
  'rss',
  'heart',
  'sparkles',
  'bolt',
  'github',
  'x',
  'discord',
];

const configSnippet = `// One number re-themes the whole site.
export const brasa = {
  colors: {
    accentHue: 35, // deep red-orange → amber
  },
  fonts: {
    display: 'Fraunces Variable',
    sans: 'Geist Variable',
    mono: 'Geist Mono Variable',
  },
} satisfies BrasaConfig;`;
---

<BaseLayout
  title="Styleguide"
  description="Every Brasa design token and component, live in both themes: OKLCH colors, fluid type, spacing, shadows, motion and the full component library."
>
  <Section id="intro" class="pt-24">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Design system"
          as="h1"
          title="Every token, both themes."
          lede="One accent hue drives the whole palette — the swatches below read their live computed values. Pin your theme with the toggle in the header; the panels under Color render both themes side by side."
        />
      </div>

      <Card class="mt-10 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <label
            for="hue-slider"
            class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase"
          >
            Accent hue — live demo
          </label>
          <p class="mt-2 max-w-md text-sm text-ink-2 text-pretty">
            Drag to re-derive the ember scale, gradients, glow and syntax colors. It is how{' '}
            <code class="font-mono text-accent">brasa.config.ts → colors.accentHue</code> re-themes
            the site from one number.
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-4">
          <input
            id="hue-slider"
            data-hue-slider
            type="range"
            min="0"
            max="360"
            step="1"
            value="35"
            class="h-9 w-44 cursor-pointer accent-(--accent)"
          />
          <output data-hue-value class="w-12 text-right font-mono text-sm text-accent">
            35
          </output>
        </div>
      </Card>
    </Container>
  </Section>

  <Section id="color" tone="surface">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Color"
          as="h2"
          size="display-md"
          title="OKLCH surfaces, warm ink."
          lede="Dark-first: a near-black canvas with a hint of brown, surfaces layered by lightness, hairlines mixed with ink. Light mode is warm paper with the same ember accent."
        />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {(['dark', 'light'] as const).map((theme) => (
          <div data-theme={theme} class="rounded-2xl border border-line bg-canvas p-6 shadow-md">
            <div class="flex items-center justify-between">
              <Badge variant={theme === 'dark' ? 'ember' : 'outline'}>
                {theme === 'dark' ? 'Dark · default' : 'Light'}
              </Badge>
              <span class="font-mono text-xs text-ink-3">[data-theme="{theme}"]</span>
            </div>
            <ul class="mt-6 space-y-3">
              {semanticTokens.map((token) => (
                <li class="flex items-center gap-4">
                  <i
                    class="size-10 shrink-0 rounded-lg border border-line-strong"
                    style={`background: var(${token.css})`}
                  />
                  <span class="w-32 shrink-0 font-mono text-sm text-ink">{token.name}</span>
                  <code
                    data-token={token.css}
                    class="min-w-0 flex-1 truncate font-mono text-xs text-ink-3"
                  >
                    —
                  </code>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <div class="flex items-center justify-between">
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Ember scale — hue-relative
          </p>
          <span class="font-mono text-xs text-ink-3">same in both themes</span>
        </div>
        <div class="mt-4 grid grid-cols-11 gap-1.5 sm:gap-2">
          {emberSteps.map((step) => (
            <figure>
              <div
                class="aspect-square rounded-md border border-line/60"
                style={`background: var(--color-ember-${step})`}
              />
              <figcaption class="mt-2 text-center font-mono text-[0.65rem] text-ink-3">
                {step}
              </figcaption>
            </figure>
          ))}
        </div>
        <div
          class="mt-6 h-16 rounded-xl border border-line shadow-sm"
          style="background: var(--gradient-ember)"
          aria-label="The ember gradient, from deep red-orange to amber"
          role="img"
        ></div>
        <p class="mt-3 font-mono text-xs text-ink-3">
          --gradient-ember: linear-gradient(100deg, oklch(0.65 0.21 &lt;hue&gt;), oklch(0.82 0.16
          &lt;hue + 40&gt;))
        </p>
      </div>
    </Container>
  </Section>

  <Section id="typography">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Typography"
          as="h2"
          size="display-md"
          title="Editorial serif, precise grotesk."
          lede="Fraunces with optical sizing for display, Geist for UI and body, Geist Mono for code and eyebrows. The scale is fluid (clamp) and tightens tracking as it grows."
        />
      </div>

      <div class="mt-10 space-y-8">
        {typeScale.map((step) => (
          <div class="flex flex-col gap-2 border-t border-line pt-6 sm:flex-row sm:gap-8">
            <span class="w-28 shrink-0 font-mono text-xs text-ink-3 uppercase">{step.name}</span>
            <p class:list={['min-w-0 text-ink text-balance', step.classes]}>{step.sample}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <Card class="p-6">
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Font pairing
          </p>
          <p class="mt-4 font-sans text-2xl font-semibold tracking-tight text-ink">
            Grotesk structure with{' '}
            <em class="font-display text-gradient-ember italic">serif emphasis</em> — display italic
            for the words that carry heat.
          </p>
        </Card>
        <Card class="p-6">
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Families
          </p>
          <ul class="mt-4 space-y-3 text-ink-2">
            <li class="font-display text-xl text-ink">
              Fraunces Variable — display, opsz 9–144, italic
            </li>
            <li class="font-sans text-base">Geist Variable — UI &amp; body, wght 100–900</li>
            <li class="font-mono text-sm">Geist Mono Variable — code, eyebrows, meta</li>
          </ul>
        </Card>
      </div>
    </Container>
  </Section>

  <Section id="space" tone="surface">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Space, radius, elevation"
          as="h2"
          size="display-md"
          title="Generous radii, soft depth."
          lede="A 0.25rem base spacing scale, rounded corners that never exceed 2rem, and shadows layered warm rather than black."
        />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2">
        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Spacing
          </p>
          <ul class="mt-6 space-y-3">
            {spacingSteps.map((step) => (
              <li class="flex items-center gap-4">
                <span class="w-16 shrink-0 font-mono text-xs text-ink-3">{step.label}</span>
                <span class:list={['h-4 rounded-xs bg-ember-gradient opacity-90', step.classes]} />
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Radii</p>
          <ul class="mt-6 grid grid-cols-4 gap-3">
            {radii.map((radius) => (
              <li class="flex flex-col items-center gap-2">
                <span
                  class:list={['size-16 border border-line-strong bg-surface-2', radius.classes]}
                />
                <span class="font-mono text-[0.65rem] text-ink-3">{radius.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-12">
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Shadows</p>
        <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {shadows.map((shadow) => (
            <li class:list={['rounded-lg border border-line bg-surface p-6', shadow.classes]}>
              <p class="font-mono text-sm text-ink-2">{shadow.name}</p>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <Section id="motion">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Motion"
          as="h2"
          size="display-md"
          title="Fast, soft, purposeful."
          lede="150–400ms on a custom cubic-bezier ease-out. Hover the tracks to compare curves. This page's headings reveal with animation-timeline: view() — scroll to watch. Everything yields to prefers-reduced-motion."
        />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2">
        <div class="space-y-4">
          <div class="group flex cursor-pointer items-center gap-4">
            <span class="w-32 shrink-0 font-mono text-xs text-ink-3">ease-out-soft</span>
            <span class="flex h-8 flex-1 items-center rounded-full border border-line bg-surface-2 px-1">
              <span class="size-6 rounded-full bg-ember-gradient transition-transform duration-(--dur-2) ease-(--ease-out-soft) group-hover:translate-x-[calc(100%+7.5rem)]" />
            </span>
          </div>
          <div class="group flex cursor-pointer items-center gap-4">
            <span class="w-32 shrink-0 font-mono text-xs text-ink-3">ease-in-out-soft</span>
            <span class="flex h-8 flex-1 items-center rounded-full border border-line bg-surface-2 px-1">
              <span class="size-6 rounded-full bg-ember-gradient transition-transform duration-(--dur-3) ease-(--ease-in-out-soft) group-hover:translate-x-[calc(100%+7.5rem)]" />
            </span>
          </div>
          <p class="text-xs text-ink-3">Durations: --dur-1 150ms · --dur-2 250ms · --dur-3 400ms</p>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Texture
          </p>
          <p class="mt-3 max-w-md text-sm text-ink-2 text-pretty">
            A film-grain overlay (SVG turbulence at very low opacity) sits above every page, and
            heroes carry a slow ember glow that follows your pointer — try the box below.
          </p>
          <div
            data-glow
            class="mt-6 grid h-40 place-items-center overflow-hidden rounded-xl border border-line"
          >
            <p class="font-display text-display-sm italic text-ink-2">move your pointer here</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="a11y" tone="surface">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Accessibility details"
          as="h2"
          size="display-md"
          title="Ember focus, warm selection."
          lede="Focus rings are ember with a 3px offset. Text selection tints with the accent. The scrollbar is thin and warm. Tab through the buttons to see the ring."
        />
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <Card class="p-6">
          <p class="text-body-lg text-ink-2 text-pretty">
            Try selecting this sentence — the highlight tints with ember and keeps the warm ink
            readable.
          </p>
        </Card>
        <Card class="flex items-center gap-3 p-6">
          <Button size="sm">Tab to me</Button>
          <Button size="sm" variant="secondary">
            Then me
          </Button>
          <Button size="sm" variant="ghost">
            And me
          </Button>
        </Card>
      </div>
    </Container>
  </Section>

  <Section id="components">
    <Container size="md">
      <div class="reveal">
        <Heading
          eyebrow="Components"
          as="h2"
          size="display-md"
          title="The core library, live."
          lede="Every component below is the real production markup — the same instances the site renders with. Flip the header toggle to audit both themes."
        />
      </div>

      <div class="mt-12 space-y-14">
        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Button</p>
          <div class="mt-5 space-y-5">
            <div class="flex flex-wrap items-center gap-4">
              <Button>Primary</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="ghost">Ghost</Button>
              <Button variant="link">Link</Button>
              <Button disabled>Disabled</Button>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <Button size="sm">Small</Button>
              <Button size="md" icon="arrow-right">
                Medium
              </Button>
              <Button size="lg" iconStart="flame">
                Large
              </Button>
              <Button href="/styleguide" variant="secondary" icon="arrow-up-right">
                As anchor
              </Button>
            </div>
          </div>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Badge</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <Badge variant="ember">
              <Icon name="flame" size={12} /> ember
            </Badge>
            <Badge variant="solid">solid</Badge>
            <Badge variant="outline">outline</Badge>
            <Badge variant="neutral">neutral</Badge>
          </div>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Card</p>
          <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <Card class="p-6">
              <h3 class="font-display text-display-sm text-ink">Static card</h3>
              <p class="mt-3 text-sm text-ink-2 text-pretty">
                A quiet surface with a hairline border and the smallest elevation.
              </p>
            </Card>
            <Card interactive class="p-6">
              <h3 class="font-display text-display-sm text-ink">Interactive card</h3>
              <p class="mt-3 text-sm text-ink-2 text-pretty">
                Hovers lift a step, the border warms up, the shadow deepens.
              </p>
            </Card>
          </div>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            SpotlightCard
          </p>
          <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <SpotlightCard class="p-6">
              <Icon name="bolt" size={22} class="text-accent" />
              <h3 class="mt-4 font-display text-display-sm text-ink">Spotlight hover</h3>
              <p class="mt-3 text-sm text-ink-2 text-pretty">
                A radial wash and an ember edge follow your cursor across the card.
              </p>
            </SpotlightCard>
            <SpotlightCard class="p-6">
              <Icon name="sun" size={22} class="text-accent" />
              <h3 class="mt-4 font-display text-display-sm text-ink">Both themes</h3>
              <p class="mt-3 text-sm text-ink-2 text-pretty">
                The effect reads the semantic accent, so it re-themes with the hue demo above.
              </p>
            </SpotlightCard>
            <SpotlightCard class="p-6">
              <Icon name="heart" size={22} class="text-accent" />
              <h3 class="mt-4 font-display text-display-sm text-ink">Reduced motion</h3>
              <p class="mt-3 text-sm text-ink-2 text-pretty">
                Transitions collapse to zero for users who prefer reduced motion.
              </p>
            </SpotlightCard>
          </div>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">
            Heading
          </p>
          <div class="mt-5 grid grid-cols-1 gap-6">
            <Heading
              eyebrow="Section heading"
              as="h3"
              size="display-md"
              title="Eyebrow, title, lede."
              lede="Aligned to the start by default, with a balanced title and a pretty lede at a comfortable measure."
            />
            <Heading
              eyebrow="Centered variant"
              as="h3"
              size="display-md"
              title="Same parts, centered."
              lede="For closing CTAs and section pivots — the eyebrow dashes mirror on both sides."
              align="center"
            />
          </div>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Icon</p>
          <ul class="mt-5 grid grid-cols-4 gap-4 rounded-2xl border border-line bg-surface p-6 sm:grid-cols-6 lg:grid-cols-8">
            {iconNames.map((name) => (
              <li class="flex flex-col items-center gap-2.5 text-ink-2">
                <Icon name={name} size={22} />
                <span class="font-mono text-[0.625rem] text-ink-3">{name}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="font-mono text-xs font-medium tracking-[0.14em] text-ink-3 uppercase">Prose</p>
          <div class="mt-5">
            <Prose>
              <h2>Prose, for long-form MDX</h2>
              <p>
                Everything a blog post or docs page needs: links that
                <a href="#color"> underline softly</a>, <strong>strong emphasis</strong> in warm
                ink,
                <em> italic asides</em>, inline <code>code</code>, keyboard hints like
                <kbd>Ctrl</kbd> + <kbd>K</kbd>, lists that mark with ember, quotes set in the
                display italic, and tables with hairline rules.
              </p>
              <ul>
                <li>Unordered items carry a small ember dash,</li>
                <li>aligned to the text rhythm,</li>
                <li>never the browser default dot.</li>
              </ul>
              <ol>
                <li>Ordered lists keep the mono numerals,</li>
                <li>tinted with the accent.</li>
              </ol>
              <blockquote>
                “The palette is the product. Get the embers right and everything else follows.”
              </blockquote>
              <Code lang="ts" title="brasa.config.ts" code={configSnippet} />
              <figure>
                <svg
                  viewBox="0 0 800 340"
                  width="800"
                  height="340"
                  role="img"
                  aria-label="Brasa brand plate: the flame mark over the ember scale"
                  class="h-auto w-full"
                >
                  <defs>
                    <linearGradient id="sg-ember" x1="0" y1="1" x2="1" y2="0">
                      <stop offset="0" style="stop-color: var(--color-ember-600)"></stop>
                      <stop offset="1" style="stop-color: var(--color-ember-300)"></stop>
                    </linearGradient>
                  </defs>
                  <rect width="800" height="340" rx="16" style="fill: var(--surface)"></rect>
                  {emberSteps.map((step, index) => (
                    <rect
                      x={40 + index * 66}
                      y={190}
                      width="52"
                      height="88"
                      rx="8"
                      style={`fill: var(--color-ember-${step})`}
                    />
                  ))}
                  <path
                    d="M404 52c11 54-4 98-37 133-31 34-66 66-66 118 0 0 0 0 0 0"
                    fill="none"
                    style="stroke: url(#sg-ember)"
                    stroke-width="0"
                  />
                  <path
                    d="M416 44c10 48-3 87-32 118-27 30-58 58-58 104a73 73 0 0 0 146 0c0-23-11-41-26-56-10-10-21-19-26-31-8 9-11 20-9 33-13-14-21-27-25-44l-7-21-3-3Z"
