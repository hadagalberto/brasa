---
import { ClientRouter } from 'astro:transitions';

import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '../styles/global.css';

import frauncesNormal from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import geistNormal from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

import { brasa } from '../brasa.config';
import { withBase } from '../lib/with-base';
import { localeLang, ui, type Locale } from '../i18n';
import SEO from '../components/SEO.astro';
import type { SeoArticle, SeoCrumb } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Path or URL for the Open Graph image. */
  image?: string;
  /** Article metadata (with type="article"): BlogPosting JSON-LD + article:* metas. */
  article?: SeoArticle;
  /** BreadcrumbList JSON-LD. */
  breadcrumbs?: SeoCrumb[];
  /** Active locale. Defaults to English for unprefixed routes. */
  lang?: Locale;
}

const { title, description, type, noindex, image, article, breadcrumbs, lang = 'en' } = Astro.props;
const strings = ui(lang).common;
---

<!doctype html>
<html
  lang={localeLang[lang]}
  style={`--accent-hue: ${brasa.colors.accentHue}; --font-display: '${brasa.fonts.display}', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif; --font-sans: '${brasa.fonts.sans}', ui-sans-serif, system-ui, sans-serif; --font-mono: '${brasa.fonts.mono}', ui-monospace, 'Cascadia Code', Consolas, monospace;`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // No-flash theme bootstrap: must run before first paint.
      (() => {
        try {
          const stored = localStorage.getItem('brasa:theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <SEO {title} {description} {type} {noindex} {image} {article} {breadcrumbs} {lang} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {brasa.features.blog && (
      <>
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${brasa.site.name} — RSS`}
          href={withBase('rss.xml')}
        />
        <link
          rel="alternate"
          type="application/feed+json"
          title={`${brasa.site.name} — JSON Feed`}
          href={withBase('feed.json')}
        />
      </>
    )}
    <link rel="preload" as="font" type="font/woff2" href={frauncesNormal} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesItalic} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={geistNormal} crossorigin />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-ink">
    <div
      data-pagefind-filter={`lang:${lang}`}
      data-pagefind-meta={`lang:${lang}`}
      class="hidden"
      aria-hidden="true"
    ></div>
    <a href="#main" class="skip-link">
      {strings.skipLink}
    </a>
    <Header {lang} />
    <main id="main" tabindex="-1" data-pagefind-body class="relative flex-1">
      <slot />
    </main>
    <Footer {lang} />
    {brasa.features.search && <SearchDialog {lang} />}
    <Analytics />
    <slot name="analytics" />
    <script>
      import '../scripts/behaviors';
      import '../scripts/search';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 200;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background-color: var(--surface-2);
    color: var(--ink);
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: var(--elev-md);
    translate: 0 -200%;
    transition: translate var(--dur-2) var(--ease-out-soft);
  }

  .skip-link:focus {
    translate: 0 0;
  }
</style>
